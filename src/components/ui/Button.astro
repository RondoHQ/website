---
interface Props {
  variant?: 'primary' | 'secondary' | 'glass' | 'outline';
  href?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
}

const {
  variant = 'primary',
  href,
  class: className = '',
  type = 'button'
} = Astro.props;

const baseClasses = 'inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold transition-all duration-200 cursor-pointer';

const variantClasses = {
  primary: 'btn-primary text-white',
  secondary: 'btn-secondary text-deep-midnight',
  glass: 'btn-glass text-slate-700',
  outline: 'btn-outline border-2'
};

const classes = `${baseClasses} ${variantClasses[variant]} ${className}`;
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}

<style>
  .btn-primary {
    background: var(--rondo-btn-primary);
  }

  .btn-primary:hover {
    background: var(--rondo-btn-primary-hover);
    box-shadow: 0 10px 24px rgba(0, 144, 139, 0.3), 0 4px 12px rgba(0, 27, 96, 0.18);
    transform: translateY(-2px);
  }

  .btn-secondary {
    background: var(--rondo-btn-secondary);
    color: var(--rondo-btn-secondary-text);
  }

  .btn-secondary:hover {
    background: var(--rondo-btn-secondary-hover);
    box-shadow: 0 10px 20px rgba(113, 219, 168, 0.28);
    transform: translateY(-2px);
  }

  .btn-glass {
    background: rgba(155, 194, 211, 0.18);
    border: 1px solid rgba(0, 27, 96, 0.12);
  }

  .btn-glass:hover {
    background: rgba(155, 194, 211, 0.28);
    transform: translateY(-2px);
  }

  .btn-outline {
    background: transparent;
    border: 2px solid var(--rondo-btn-outline);
    color: var(--rondo-btn-outline);
  }

  .btn-outline:hover {
    background: rgba(0, 144, 139, 0.08);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0, 144, 139, 0.2);
  }
</style>
