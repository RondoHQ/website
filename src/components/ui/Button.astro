---
interface Props {
  variant?: 'primary' | 'secondary' | 'glass';
  href?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
}

const {
  variant = 'primary',
  href,
  class: className = '',
  type = 'button'
} = Astro.props;

const baseClasses = 'inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold transition-all duration-200 cursor-pointer';

const variantClasses = {
  primary: 'btn-primary bg-electric-cyan text-obsidian',
  secondary: 'btn-secondary bg-bright-cobalt text-white',
  glass: 'btn-glass text-white'
};

const classes = `${baseClasses} ${variantClasses[variant]} ${className}`;
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}

<style>
  /* Primary button: dark text on cyan (excellent contrast) */
  .btn-primary:hover {
    background: #1ab4ce;
    box-shadow: 0 10px 20px rgba(34, 211, 238, 0.3);
    transform: translateY(-2px);
  }

  /* Secondary button: white text on cobalt blue */
  .btn-secondary:hover {
    background: #2563eb;
    box-shadow: 0 10px 20px rgba(59, 130, 246, 0.3);
    transform: translateY(-2px);
  }

  /* Glass button: translucent with blur */
  .btn-glass {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .btn-glass:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
  }

  /* Mobile: reduce blur for better performance */
  @media (max-width: 768px) {
    .btn-glass {
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
  }

  /* Accessibility: remove blur for users who prefer reduced transparency */
  @media (prefers-reduced-transparency: reduce) {
    .btn-glass {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: rgba(255, 255, 255, 0.2);
    }

    .btn-glass:hover {
      background: rgba(255, 255, 255, 0.3);
    }
  }

  /* Fallback for browsers that don't support backdrop-filter */
  @supports not (backdrop-filter: blur(10px)) {
    .btn-glass {
      background: rgba(255, 255, 255, 0.2);
    }

    .btn-glass:hover {
      background: rgba(255, 255, 255, 0.3);
    }
  }
</style>
