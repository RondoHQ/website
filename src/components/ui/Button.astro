---
interface Props {
  variant?: 'primary' | 'secondary' | 'glass' | 'outline';
  href?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
}

const {
  variant = 'primary',
  href,
  class: className = '',
  type = 'button'
} = Astro.props;

const baseClasses = 'inline-flex items-center justify-center px-6 py-3 rounded-full font-semibold transition-colors duration-200 cursor-pointer';

const variantClasses = {
  primary: 'btn-primary text-white',
  secondary: 'btn-secondary text-deep-midnight',
  glass: 'btn-glass text-slate-700',
  outline: 'btn-outline'
};

const classes = `${baseClasses} ${variantClasses[variant]} ${className}`;
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}

<style>
  a, button { font-size: 1.125rem; line-height: 1.3; max-width: 100%; text-align: center; }
  .btn-primary { background: var(--rondo-btn-primary); color: white; }
  .btn-primary:hover { background: var(--rondo-btn-primary-hover); }
  .btn-secondary { background: var(--rondo-btn-secondary); color: var(--rondo-btn-secondary-text); }
  .btn-secondary:hover { background: var(--rondo-btn-secondary-hover); }
  .btn-glass { background: var(--rondo-surface-soft); border: 1px solid var(--rondo-border-soft); }
  .btn-glass:hover { background: #DDEFE9; }
  .btn-outline { background: transparent; border: 1px solid var(--rondo-btn-outline); color: var(--rondo-btn-outline); }
  .btn-outline:hover { background: #9933990D; }
</style>
