---
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<div class={`card ${className}`}>
  {title && <h3 class="font-bold mb-3">{title}</h3>}
  <slot />
</div>

<style>
  .card { background: var(--rondo-surface-soft); padding: 2.35rem 1.5rem 1.5rem; border-radius: 0 0 1.25rem 1.25rem; position: relative; overflow: hidden; }
  .card::before { content: ''; position: absolute; inset: 0 0 auto; height: 6px; background: var(--rondo-gradient-green); }
  .card:nth-child(3n + 2)::before { background: var(--rondo-gradient-violet); }
  .card:nth-child(3n)::before { background: var(--rondo-gradient-orange); }
</style>
