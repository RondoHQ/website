---
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<div class={`card p-6 md:p-8 ${className}`}>
  {title && <h3 class="text-white font-semibold text-xl mb-4">{title}</h3>}
  <slot />
</div>

<style>
  .card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 32px 0 rgba(30, 58, 138, 0.3);
    border-radius: 1rem;
    transition: background 0.2s ease;
  }

  .card:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  /* Mobile: reduce blur for better performance */
  @media (max-width: 768px) {
    .card {
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
  }

  /* Accessibility: remove blur for users who prefer reduced transparency */
  @media (prefers-reduced-transparency: reduce) {
    .card {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: rgba(255, 255, 255, 0.15);
    }

    .card:hover {
      background: rgba(255, 255, 255, 0.2);
    }
  }

  /* Fallback for browsers that don't support backdrop-filter */
  @supports not (backdrop-filter: blur(10px)) {
    .card {
      background: rgba(255, 255, 255, 0.15);
    }

    .card:hover {
      background: rgba(255, 255, 255, 0.2);
    }
  }
</style>
