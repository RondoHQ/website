---
interface Props {
  label: string;
  name: string;
  type?: 'text' | 'email' | 'password' | 'tel' | 'url' | 'number' | 'date' | 'time';
  placeholder?: string;
  required?: boolean;
  class?: string;
}

const {
  label,
  name,
  type = 'text',
  placeholder,
  required = false,
  class: className = ''
} = Astro.props;
---

<div class={`input-wrapper ${className}`}>
  <label for={name} class="text-sm font-medium text-slate-600 mb-1 block">
    {label}
  </label>
  <input
    type={type}
    id={name}
    name={name}
    placeholder={placeholder}
    required={required}
    class="input-field"
  />
</div>

<style>
  .input-field {
    width: 100%;
    background: white;
    border: 1px solid #CBD5E1;
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    color: #001B60;
    font-size: 1rem;
    transition: all 0.2s ease;
    outline: none;
  }

  .input-field::placeholder {
    color: #94A3B8;
  }

  .input-field:focus {
    border-color: #29A09C;
    box-shadow: 0 0 0 3px rgba(8, 145, 178, 0.15);
  }
</style>
