---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`glass-panel ${className}`}>
  <slot />
</div>

<style>
  .glass-panel {
    background: var(--rondo-surface-soft);
    border: 1px solid var(--rondo-border-soft);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    border-radius: 1rem;
  }
</style>
