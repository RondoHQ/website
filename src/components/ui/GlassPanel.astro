---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`glass-panel ${className}`}>
  <slot />
</div>

<style>
  .glass-panel {
    background: #F2F7FA;
    border: 1px solid #D8E3EE;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    border-radius: 1rem;
  }
</style>
