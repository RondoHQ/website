---
import type { Lang } from '../../i18n/utils';
import { getLangFromUrl, getAlternatePaths } from '../../i18n/utils';
import { t } from '../../i18n/translations';

interface Props {
  lang?: Lang;
  hideLangSwitcher?: boolean;
}

const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const hideLangSwitcher = Astro.props.hideLangSwitcher === true;
const prefix = lang === 'en' ? '/en' : '';
const paths = getAlternatePaths(Astro.url.pathname);

const navItems = [
  { href: `${prefix}/#product`, label: t('nav.product', lang) },
  { href: `${prefix}/#rollen`, label: t('nav.roles', lang) },
  { href: `${prefix}/#integratie`, label: t('nav.integration', lang) },
  { href: `${prefix}/#kosten`, label: t('nav.costs', lang) },
  { href: `${prefix}/#faq`, label: t('nav.faq', lang) },
  { href: `${prefix}/contact/`, label: t('nav.contact', lang) },
];
---

<header class="header">
  <nav class="nav-container">
    <a href={`${prefix}/`} class="logo-link">
      <img src="/design/logo-icon.svg" alt="" aria-hidden="true" class="logo-icon" width="62.8677" height="64" loading="eager" fetchpriority="high" />
      <img src="/design/logo-wordmark.svg" alt="Rondo" class="logo-wordmark" width="182.424" height="36.2824" loading="eager" fetchpriority="high" />
    </a>
    <button class="hamburger" aria-label="Menu" aria-expanded="false" aria-controls="site-navigation">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
    <div class="nav-links" id="site-navigation">
      {navItems.map(item => (
        <a href={item.href} class="nav-link">{item.label}</a>
      ))}
      {!hideLangSwitcher && (
        <div class="lang-switcher">
          <a href={paths.nl} class:list={['lang-link', { active: lang === 'nl' }]}>NL</a>
          <span class="lang-sep">|</span>
          <a href={paths.en} class:list={['lang-link', { active: lang === 'en' }]}>EN</a>
        </div>
      )}
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector('.header');
  const hamburger = document.querySelector('.hamburger');
  const navLinks = document.querySelector('.nav-links');
  let scrolled = false;

  function onScroll() {
    const shouldShrink = window.scrollY > 50;
    if (shouldShrink !== scrolled) {
      scrolled = shouldShrink;
      header?.classList.toggle('scrolled', scrolled);
    }
  }

  hamburger?.addEventListener('click', () => {
    const expanded = hamburger.getAttribute('aria-expanded') === 'true';
    hamburger.setAttribute('aria-expanded', String(!expanded));
    navLinks?.classList.toggle('open');
  });

  navLinks?.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', () => {
      navLinks.classList.remove('open');
      hamburger?.setAttribute('aria-expanded', 'false');
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && navLinks?.classList.contains('open')) {
      navLinks.classList.remove('open');
      hamburger?.setAttribute('aria-expanded', 'false');
      (hamburger as HTMLButtonElement)?.focus();
    }
  });

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .header { position: sticky; top: 0; z-index: 50; background: var(--rondo-surface-header); }
  .header.scrolled { box-shadow: -4px -2px 10px #0000000F, 6px 6px 16px #00000014; }
  .nav-container { max-width: var(--rondo-content-width); margin: auto; min-height: 96px; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .logo-link { display: flex; align-items: center; gap: 10px; flex-shrink: 0; text-decoration: none; }
  .logo-icon, .logo-wordmark { display: block; max-width: none; }
  .nav-links { display: flex; gap: 6px; align-items: center; }
  .nav-link { padding: 8px 12px; color: #334155; font-size: 18px; line-height: 1.2; text-decoration: none; }
  .nav-link:hover, .lang-link:hover { color: var(--rondo-indigo); }
  .lang-switcher { display: flex; align-items: center; border-left: 1px solid #CBD5E1; padding-left: 4px; min-height: 42px; }
  .lang-link { padding: 12px; font-size: 15px; color: #334155; text-decoration: none; }
  .lang-link.active { color: var(--rondo-indigo); font-weight: 600; }
  .lang-sep { color: #94A3B8; font-size: 12px; }
  .hamburger { display: none; border: 0; background: none; padding: 12px; cursor: pointer; }
  .hamburger-line { display: block; width: 24px; height: 2px; margin: 5px 0; background: var(--rondo-navy); }
  .hamburger[aria-expanded='true'] .hamburger-line:first-child { transform: translateY(7px) rotate(45deg); }
  .hamburger[aria-expanded='true'] .hamburger-line:nth-child(2) { opacity: 0; }
  .hamburger[aria-expanded='true'] .hamburger-line:last-child { transform: translateY(-7px) rotate(-45deg); }
  @media (max-width: 1320px) { .nav-container { margin-inline: 24px; } }
  @media (max-width: 1100px) {
    .nav-container { min-height: 88px; margin-inline: 20px; }
    .hamburger { display: block; }
    .nav-links { display: none; position: absolute; inset: 100% 0 auto; background: var(--rondo-surface-header); border-bottom: 1px solid var(--rondo-border-soft); padding: 16px 20px; }
    .nav-links.open { display: flex; flex-direction: column; align-items: stretch; }
    .nav-link { padding: 12px; }
    .lang-switcher { border-left: 0; border-top: 1px solid var(--rondo-border-soft); }
  }
  @media (max-width: 380px) { .logo-link { transform: scale(.85); transform-origin: left center; margin-right: -38px; } }
</style>
