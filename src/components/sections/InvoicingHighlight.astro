---
import type { Lang } from '../../i18n/utils';
import { getLangFromUrl } from '../../i18n/utils';
import { t } from '../../i18n/translations';

interface Props { lang?: Lang; }
const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const prefix = lang === 'en' ? '/en' : '';
---

<section id="facturatie" class="py-20 bg-gradient-to-b from-white to-slate-50">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-10">
      <h2 class="text-4xl md:text-5xl font-bold gradient-text mb-4">
        {t('invoicing.heading', lang)}
      </h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto">
        {t('invoicing.subheading', lang)}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
      <div class="rounded-2xl bg-white border border-slate-200 p-8 shadow-sm">
        <h3 class="text-2xl font-semibold text-slate-900 mb-4">{t('invoicing.dues.title', lang)}</h3>
        <ul class="space-y-3 text-slate-700">
          <li><strong>{t('invoicing.dues.rules', lang)}</strong><br />{t('invoicing.dues.rules.desc', lang)}</li>
          <li><strong>{t('invoicing.dues.bulk', lang)}</strong><br />{t('invoicing.dues.bulk.desc', lang)}</li>
          <li><strong>{t('invoicing.dues.installments', lang)}</strong><br />{t('invoicing.dues.installments.desc', lang)}</li>
          <li><strong>{t('invoicing.dues.reminders', lang)}</strong><br />{t('invoicing.dues.reminders.desc', lang)}</li>
          <li><strong>{t('invoicing.dues.emails', lang)}</strong><br />{t('invoicing.dues.emails.desc', lang)}</li>
        </ul>
      </div>

      <div class="rounded-2xl bg-white border border-slate-200 p-8 shadow-sm">
        <h3 class="text-2xl font-semibold text-slate-900 mb-4">{t('invoicing.disciplinary.title', lang)}</h3>
        <ul class="space-y-3 text-slate-700">
          <li><strong>{t('invoicing.disciplinary.linked', lang)}</strong><br />{t('invoicing.disciplinary.linked.desc', lang)}</li>
          <li><strong>{t('invoicing.disciplinary.admin', lang)}</strong><br />{t('invoicing.disciplinary.admin.desc', lang)}</li>
        </ul>

        <h3 class="text-2xl font-semibold text-slate-900 mb-4 mt-8">{t('invoicing.both.title', lang)}</h3>
        <ul class="space-y-3 text-slate-700">
          <li><strong>{t('invoicing.both.ideal', lang)}</strong><br />{t('invoicing.both.ideal.desc', lang)}</li>
          <li><strong>{t('invoicing.both.status', lang)}</strong><br />{t('invoicing.both.status.desc', lang)}</li>
          <li><strong>{t('invoicing.both.pdf', lang)}</strong><br />{t('invoicing.both.pdf.desc', lang)}</li>
          <li><strong>{t('invoicing.both.control', lang)}</strong><br />{t('invoicing.both.control.desc', lang)}</li>
        </ul>
      </div>
    </div>

    <div class="text-center mt-10">
      <p class="text-lg text-slate-600 mb-6">
        {t('invoicing.noNikki', lang)}
      </p>
      <a href="#contact" class="inline-flex items-center justify-center rounded-xl bg-electric-cyan px-7 py-3 text-white font-semibold hover:opacity-90 transition-opacity">
        {t('invoicing.cta', lang)}
      </a>
    </div>
  </div>
</section>
