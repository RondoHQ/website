---
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import type { Lang } from '../../i18n/utils';
import { getLangFromUrl } from '../../i18n/utils';
import { t } from '../../i18n/translations';

interface Props { lang?: Lang; }
const lang = Astro.props.lang || getLangFromUrl(Astro.url);

const examples = [
  { members: 250, price: 375 },
  { members: 500, price: 500 },
  { members: 1000, price: 750 },
];
---

<section id="prijzen" class="py-20 pricing-section">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-bold gradient-text mb-4">{t('pricing.heading', lang)}</h2>
      <p class="text-xl text-slate-600">{t('pricing.subheading', lang)}</p>
    </div>

    <div class="pricing-hero max-w-2xl mx-auto mb-12 p-8 md:p-10 rounded-2xl">
      <h3 class="text-2xl font-semibold text-white mb-4 text-center">{t('pricing.formula', lang)}</h3>
      <div class="text-center space-y-2">
        <p class="text-3xl">
          <span class="text-white font-bold">{t('pricing.base', lang)}</span>
          <span class="text-cyan-100"> {t('pricing.baseSuffix', lang)}</span>
        </p>
        <p class="text-2xl text-cyan-100">
          <span class="text-white font-bold">{t('pricing.perMember', lang)}</span> {t('pricing.perMemberSuffix', lang)}
        </p>
      </div>
      <p class="text-sm text-cyan-200 text-center mt-6">{t('pricing.includes', lang)}</p>
      <p class="text-xs text-cyan-300 text-center mt-2 opacity-70">{t('pricing.note', lang)}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      {examples.map((example) => (
        <Card class="text-center">
          <p class="text-3xl font-bold text-slate-800 mb-2">
            {example.members} {t('pricing.members', lang)}
          </p>
          <p class="text-2xl font-semibold text-electric-cyan mb-4">
            €{example.price}{t('pricing.perYear', lang)}
          </p>
          <p class="text-sm text-slate-500">
            €250 + ({example.members} × €0,50)
          </p>
        </Card>
      ))}
    </div>

    <div class="text-center">
      <Button variant="primary" href="#contact">{t('pricing.cta', lang)}</Button>
      <p class="text-sm text-slate-500 mt-6" set:html={t('pricing.openSource', lang)} />
    </div>
  </div>
</section>

<style>
  .pricing-hero {
    background: linear-gradient(135deg, #0891B2 0%, #2563EB 100%);
    box-shadow: 0 10px 40px rgba(8, 145, 178, 0.3), 0 4px 16px rgba(37, 99, 235, 0.2);
  }
</style>
