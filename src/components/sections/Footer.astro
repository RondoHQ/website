---
import type { Lang } from '../../i18n/utils';
import { getLangFromUrl } from '../../i18n/utils';
import { t } from '../../i18n/translations';

interface Props { lang?: Lang; }
const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const prefix = lang === 'en' ? '/en' : '';
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-container">
    <p class="copyright">
      &copy; {currentYear} Emilia Projects BV, Wijchen — KvK 89067959
    </p>
    <div class="legal-links">
      <a href={`${prefix}/made-in-europe`} class="legal-link europe-badge">🇪🇺 {t('footer.madeInEurope', lang)}</a>
      <a href="https://github.com/rondohq" target="_blank" rel="noopener" class="legal-link github-link"><svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg> {t('footer.openSource', lang)}</a>
      <a href={lang === 'en' ? '/en/privacy' : '/privacybeleid'} class="legal-link">{t('footer.privacy', lang)}</a>
      <a href={lang === 'en' ? '/en/terms' : '/voorwaarden'} class="legal-link">{t('footer.terms', lang)}</a>
    </div>
  </div>
  <div class="disclaimer-container">
    <p class="disclaimer">
      {t('footer.disclaimer', lang)}
    </p>
  </div>
</footer>

<style>
  .footer {
    padding: 2rem 0;
    background: #0F172A;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .footer-container {
      flex-direction: row;
    }
  }

  .copyright {
    color: #CBD5E1;
    font-size: 0.875rem;
  }

  .legal-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .github-link {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .legal-link {
    color: #CBD5E1;
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.2s ease-in-out;
  }

  .legal-link:hover {
    color: #F1F5F9;
  }

  .europe-badge {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    background: rgba(96, 165, 250, 0.1);
    border: 1px solid rgba(96, 165, 250, 0.2);
    border-radius: 9999px;
    padding: 0.25rem 0.75rem;
    color: #93C5FD;
    font-weight: 500;
    transition: background 0.2s ease-in-out, color 0.2s ease-in-out;
  }

  .europe-badge:hover {
    background: rgba(96, 165, 250, 0.2);
    color: #BFDBFE;
  }

  .disclaimer-container {
    max-width: 80rem;
    margin: 0 auto;
    margin-top: 1.25rem;
    padding: 0.75rem 1rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .disclaimer {
    color: #94A3B8;
    font-size: 0.75rem;
    text-align: center;
  }
</style>
