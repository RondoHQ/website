---
import Card from '../ui/Card.astro';
---

<section id="support" class="py-20">
  <div class="max-w-7xl mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-bold gradient-text mb-4">
        Persoonlijke support
      </h2>
      <p class="text-xl text-slate-600">
        Geen ticketnummers, geen wachtrijen
      </p>
    </div>

    <!-- Support cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <Card>
        <div class="support-icon mb-4" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="support-icon-svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
          </svg>
        </div>
        <h3 class="font-semibold mb-2">Direct contact</h3>
        <p class="text-slate-600">
          Via e-mail of het ingebouwde feedbacksysteem in Rondo Club. Je praat met iemand die het systeem daadwerkelijk gebouwd heeft.
        </p>
      </Card>

      <Card>
        <div class="support-icon mb-4" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="support-icon-svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        </div>
        <h3 class="font-semibold mb-2">Reactie binnen 24-48 uur</h3>
        <p class="text-slate-600">
          Op werkdagen krijg je binnen een dag antwoord. Geen chatbot, geen standaard­antwoorden — gewoon een persoonlijke reactie.
        </p>
      </Card>

      <Card>
        <div class="support-icon mb-4" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="support-icon-svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
          </svg>
        </div>
        <h3 class="font-semibold mb-2">Documentatie</h3>
        <p class="text-slate-600">
          Technische documentatie is beschikbaar. Functionele handleidingen worden doorlopend aangevuld.
        </p>
      </Card>
    </div>
  </div>
</section>

<style>
  .support-icon-svg {
    width: 2rem;
    height: 2rem;
    color: #0891B2;
  }
</style>
