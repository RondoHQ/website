---
import Button from '../ui/Button.astro';
---

<section class="hero-section">
  <div class="hero-blob hero-blob-1" aria-hidden="true"></div>
  <div class="hero-blob hero-blob-2" aria-hidden="true"></div>
  <div class="hero-container">
    <div class="hero-grid">
      <!-- Left column: headline, subline, CTA -->
      <div class="hero-content">
        <h1 class="hero-headline gradient-text">
          Niemand weet welke ledenlijst de juiste is
        </h1>
        <p class="hero-subline">
          Met Rondo hoeft dat niet meer. Ledendata stroomt automatisch van Sportlink naar overal waar je het nodig hebt.
        </p>
        <div class="hero-cta-group">
          <Button variant="primary" href="#product">
            Bekijk wat Rondo doet
          </Button>
          <Button variant="outline" href="https://demo.rondo.club" class="demo-btn">
            Probeer de demo
          </Button>
        </div>
        <p class="demo-hint">
          Inloggen met gebruikersnaam <strong>demo</strong> en wachtwoord <strong>demo</strong>
        </p>
      </div>

      <!-- Right column: product screenshot -->
      <div class="hero-screenshot">
        <button class="screenshot-frame" id="screenshot-trigger" type="button" aria-label="Vergroot screenshot">
          <img
            src="/screenshot-leden-lijst-small.webp"
            srcset="/screenshot-leden-lijst-small.webp 480w, /screenshot-leden-lijst-thumb.webp 960w, /screenshot-leden-lijst.webp 1920w"
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 640px"
            data-full="/screenshot-leden-lijst.webp"
            alt="Rondo Club ledenlijst"
            class="hero-slide active"
            data-index="0"
            width="480" height="267"
            loading="eager"
            fetchpriority="high"
          />
          <img
            src="/screenshot-vog-overzicht-small.webp"
            srcset="/screenshot-vog-overzicht-small.webp 480w, /screenshot-vog-overzicht-thumb.webp 960w, /screenshot-vog-overzicht.webp 1920w"
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 640px"
            data-full="/screenshot-vog-overzicht.webp"
            alt="VOG tracking overzicht"
            class="hero-slide"
            data-index="1"
            width="480" height="268"
            loading="lazy"
          />
          <img
            src="/screenshot-contributie-overzicht-small.webp"
            srcset="/screenshot-contributie-overzicht-small.webp 480w, /screenshot-contributie-overzicht-thumb.webp 960w, /screenshot-contributie-overzicht.webp 1920w"
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 640px"
            data-full="/screenshot-contributie-overzicht.webp"
            alt="Contributie overzicht"
            class="hero-slide"
            data-index="2"
            width="480" height="268"
            loading="lazy"
          />
          <img
            src="/screenshot-teams-overzicht-small.webp"
            srcset="/screenshot-teams-overzicht-small.webp 480w, /screenshot-teams-overzicht-thumb.webp 960w, /screenshot-teams-overzicht.webp 1920w"
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 640px"
            data-full="/screenshot-teams-overzicht.webp"
            alt="Teams overzicht"
            class="hero-slide"
            data-index="3"
            width="480" height="268"
            loading="lazy"
          />
          <img
            src="/screenshot-commissie-overzicht-small.webp"
            srcset="/screenshot-commissie-overzicht-small.webp 480w, /screenshot-commissie-overzicht-thumb.webp 960w, /screenshot-commissie-overzicht.webp 1920w"
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 640px"
            data-full="/screenshot-commissie-overzicht.webp"
            alt="Commissies overzicht"
            class="hero-slide"
            data-index="4"
            width="480" height="268"
            loading="lazy"
          />
        </button>
        <!-- Dot indicators -->
        <div class="hero-dots">
          <button class="hero-dot active" data-index="0" type="button" aria-label="Ga naar slide 1"></button>
          <button class="hero-dot" data-index="1" type="button" aria-label="Ga naar slide 2"></button>
          <button class="hero-dot" data-index="2" type="button" aria-label="Ga naar slide 3"></button>
          <button class="hero-dot" data-index="3" type="button" aria-label="Ga naar slide 4"></button>
          <button class="hero-dot" data-index="4" type="button" aria-label="Ga naar slide 5"></button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Lightbox overlay -->
<div class="lightbox" id="lightbox" role="dialog" aria-label="Screenshot vergroot" aria-modal="true">
  <button class="lightbox-close" id="lightbox-close" type="button" aria-label="Sluiten">&times;</button>
  <img
    src=""
    alt=""
    class="lightbox-img"
    id="lightbox-img"
  />
</div>

<script>
  const trigger = document.getElementById('screenshot-trigger');
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.getElementById('lightbox-close');
  const slides = document.querySelectorAll<HTMLImageElement>('.hero-slide');
  const dots = document.querySelectorAll('.hero-dot');
  const heroScreenshot = document.querySelector('.hero-screenshot');

  let currentIndex = 0;
  let rotationInterval: ReturnType<typeof setInterval> | null = null;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function showSlide(index: number) {
    slides.forEach((slide, i) => {
      if (i === index) {
        slide.classList.add('active');
      } else {
        slide.classList.remove('active');
      }
    });
    dots.forEach((dot, i) => {
      if (i === index) {
        dot.classList.add('active');
      } else {
        dot.classList.remove('active');
      }
    });
    currentIndex = index;
  }

  function nextSlide() {
    const next = (currentIndex + 1) % slides.length;
    showSlide(next);
  }

  function startRotation() {
    if (!prefersReducedMotion) {
      rotationInterval = setInterval(nextSlide, 4000);
    }
  }

  function stopRotation() {
    if (rotationInterval) {
      clearInterval(rotationInterval);
      rotationInterval = null;
    }
  }

  // Dot click handlers
  dots.forEach((dot, index) => {
    dot.addEventListener('click', (e) => {
      e.stopPropagation(); // Prevent triggering screenshot-frame click
      showSlide(index);
      stopRotation();
      startRotation(); // Reset timer
    });
  });

  // Pause on hover
  heroScreenshot?.addEventListener('mouseenter', stopRotation);
  heroScreenshot?.addEventListener('mouseleave', startRotation);

  // Lightbox
  trigger?.addEventListener('click', () => {
    const currentSlide = slides[currentIndex];
    if (lightboxImg && currentSlide) {
      lightboxImg.src = currentSlide.dataset.full || currentSlide.src;
      lightboxImg.alt = currentSlide.alt;
    }
    lightbox?.classList.add('active');
    document.body.style.overflow = 'hidden';
  });

  function closeLightbox() {
    lightbox?.classList.remove('active');
    document.body.style.overflow = '';
  }

  closeBtn?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox?.classList.contains('active')) closeLightbox();
  });

  // Start rotation
  startRotation();
</script>

<style>
  .hero-section {
    display: flex;
    align-items: center;
    padding: 5rem 0 4rem;
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #F8FFFE 0%, #FFFFFF 100%);
  }

  .hero-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.4;
    pointer-events: none;
  }

  .hero-blob-1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #22D3EE 0%, transparent 70%);
    top: -200px;
    left: -100px;
  }

  .hero-blob-2 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, #818CF8 0%, transparent 70%);
    top: -100px;
    right: -150px;
  }

  .hero-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1rem;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
  }

  .hero-headline {
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }

  @media (min-width: 640px) {
    .hero-headline {
      font-size: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-headline {
      font-size: 3.75rem;
    }
  }

  .hero-subline {
    font-size: 1.125rem;
    color: #475569;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  @media (min-width: 1024px) {
    .hero-subline {
      font-size: 1.25rem;
    }
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .demo-hint {
    font-size: 0.8125rem;
    color: #94A3B8;
    margin-top: 0.75rem;
  }

  .demo-hint strong {
    color: #64748B;
    font-weight: 600;
  }

  .hero-screenshot {
    width: 100%;
  }

  .screenshot-frame {
    display: block;
    width: 100%;
    border: none;
    padding: 0;
    border-radius: 1rem;
    box-shadow:
      0 25px 50px -12px rgba(0, 0, 0, 0.15),
      0 0 0 1px rgba(0, 0, 0, 0.08);
    background: #F8FAFC;
    overflow: hidden;
    cursor: zoom-in;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    position: relative;
    aspect-ratio: 16 / 9;
  }

  .screenshot-frame:hover {
    transform: scale(1.02);
    box-shadow:
      0 30px 60px -15px rgba(0, 0, 0, 0.2),
      0 0 0 1px rgba(0, 0, 0, 0.1);
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.6s ease;
    display: block;
  }

  .hero-slide.active {
    opacity: 1;
  }

  .hero-dots {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
    margin-top: 0.5rem;
  }

  .hero-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: none;
    padding: 16px;
    background-clip: content-box;
    cursor: pointer;
    background-color: #CBD5E1;
    transition: background-color 0.2s;
  }

  .hero-dot.active {
    background-color: #0E7490;
  }

  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    align-items: center;
    justify-content: center;
    padding: 2rem;
    cursor: zoom-out;
  }

  .lightbox.active {
    display: flex;
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    border-radius: 0.75rem;
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5);
  }

  .lightbox-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
    font-size: 1.5rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.4);
  }
</style>
