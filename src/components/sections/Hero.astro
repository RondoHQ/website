---
import Button from '../ui/Button.astro';
import type { Lang } from '../../i18n/utils';
import { getLangFromUrl } from '../../i18n/utils';
import { t } from '../../i18n/translations';
interface Props { lang?: Lang; }
const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const caption = lang === 'en' ? 'Committees overview in Rondo' : 'Commissieoverzicht in Rondo';
---
<section class="hero-section">
  <img class="hero-background" src="/design/hero-background.svg" alt="" aria-hidden="true" />
  <img class="hero-art" src="/design/shape-purple.svg" alt="" aria-hidden="true" />
  <div class="rondo-container hero-grid">
    <div class="hero-content">
      <h1>{t('hero.headline', lang)}</h1>
      <p class="hero-subline">{t('hero.subline', lang)}</p>
      <div class="hero-actions">
        <Button href="#product">{t('hero.cta.product', lang)}</Button>
        <Button variant="outline" href="https://demo.rondo.club" class="hero-demo">{t('hero.cta.demo', lang)}</Button>
      </div>
    </div>
    <button class="hero-screenshot" type="button" aria-label={lang === 'en' ? 'Enlarge screenshot' : 'Vergroot screenshot'}>
      <img src="/design/committees.png" alt={caption} width="608" height="340" fetchpriority="high" />
    </button>
  </div>
</section>
<dialog class="hero-lightbox" aria-label={caption}>
  <button class="hero-close" type="button" aria-label={lang === 'en' ? 'Close' : 'Sluiten'}>&times;</button>
  <img src="/design/committees.png" alt={caption} width="608" height="340" />
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('.hero-lightbox');
  document.querySelector('.hero-screenshot')?.addEventListener('click', () => dialog?.showModal());
  document.querySelector('.hero-close')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
</script>
<style>
  .hero-section { position: relative; overflow: clip; padding: 56px 0 60px; background: var(--rondo-teal-dark); }
  .hero-background { position: absolute; top: -68px; left: calc(50% - 864px); max-width: none; pointer-events: none; }
  .hero-art { position: absolute; left: calc(50% + 506px); top: -176px; max-width: none; pointer-events: none; }
  .hero-grid { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; align-items: start; }
  .hero-content { padding-top: 24px; }
  h1 { color: white; font-size: 64px; line-height: 1; font-weight: 700; max-width: 592px; }
  .hero-subline { max-width: 592px; font-size: 20px; font-weight: 700; line-height: 26px; color: white; margin-top: 16px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 28px; margin-top: 32px; }
  .hero-actions :global(.hero-demo) { color: white; border-color: white; }
  .hero-actions :global(.hero-demo:hover) { background: #FFFFFF18; }
  .hero-screenshot { border-radius: 16px; overflow: hidden; cursor: zoom-in; box-shadow: -4px -2px 10px #0000000F, 6px 6px 16px #00000014; }
  .hero-screenshot img { display: block; width: 100%; height: auto; aspect-ratio: 608 / 340; object-fit: cover; }
  .hero-lightbox { margin: auto; padding: 48px 20px 20px; border: 0; border-radius: 16px; max-width: min(1200px, 94vw); background: white; }
  .hero-lightbox::backdrop { background: #001153CC; }
  .hero-lightbox img { width: 100%; max-height: 80vh; object-fit: contain; }
  .hero-close { position: absolute; top: 4px; right: 8px; width: 44px; height: 44px; font-size: 32px; cursor: pointer; }
  @media (max-width: 1200px) { h1 { font-size: 52px; } }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 36px; }
    .hero-content { padding-top: 0; }
    .hero-section { padding: 40px 0; }
    h1 { font-size: clamp(36px, 6.5vw, 56px); line-height: 1.05; }
    .hero-subline { font-size: 18px; line-height: 1.4; }
    .hero-art { left: calc(100% - 32px); }
    .hero-screenshot { max-width: 608px; }
    .hero-actions { gap: 16px; margin-top: 28px; }
  }
</style>
