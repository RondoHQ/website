---
import Button from '../ui/Button.astro';
import type { Lang } from '../../i18n/utils';
import { getLangFromUrl } from '../../i18n/utils';
import { t } from '../../i18n/translations';

interface Props { lang?: Lang; }
const lang = Astro.props.lang || getLangFromUrl(Astro.url);
---

<section class="hero-section">
  <div class="hero-blob hero-blob-1" aria-hidden="true"></div>
  <div class="hero-blob hero-blob-2" aria-hidden="true"></div>
  <div class="hero-blob hero-blob-3" aria-hidden="true"></div>
  <div class="hero-container">
    <div class="hero-grid">
      <div class="hero-content">
        <h1 class="hero-headline gradient-text">
          {t('hero.headline', lang)}
        </h1>
        <p class="hero-subline">
          {t('hero.subline', lang)}
        </p>
        <div class="hero-cta-group">
          <Button variant="primary" href="#product">
            {t('hero.cta.product', lang)}
          </Button>
          <Button variant="outline" href="https://demo.rondo.club" class="demo-btn">
            {t('hero.cta.demo', lang)}
          </Button>
        </div>
        <p class="demo-hint" set:html={t('hero.demo.hint', lang)} />
      </div>

      <div class="hero-screenshot">
        <button class="screenshot-frame" id="screenshot-trigger" type="button" aria-label={lang === 'en' ? 'Enlarge screenshot' : 'Vergroot screenshot'}>
          <img src="/screenshot-dashboard-small.webp" srcset="/screenshot-dashboard-small.webp 480w, /screenshot-dashboard-thumb.webp 960w, /screenshot-dashboard.webp 1920w" sizes="(max-width: 768px) 400px, (max-width: 1024px) 50vw, 640px" data-full="/screenshot-dashboard.webp" alt={lang === 'en' ? 'Rondo dashboard overview' : 'Rondo dashboard overzicht'} class="hero-slide active" data-index="0" width="480" height="267" loading="eager" fetchpriority="high" />
          <img src="/screenshot-vog-overzicht-small.webp" srcset="/screenshot-vog-overzicht-small.webp 480w, /screenshot-vog-overzicht-thumb.webp 960w, /screenshot-vog-overzicht.webp 1920w" sizes="(max-width: 768px) 400px, (max-width: 1024px) 50vw, 640px" data-full="/screenshot-vog-overzicht.webp" alt="VOG tracking" class="hero-slide" data-index="1" width="480" height="268" loading="lazy" />
          <img src="/screenshot-contributie-overzicht-small.webp" srcset="/screenshot-contributie-overzicht-small.webp 480w, /screenshot-contributie-overzicht-thumb.webp 960w, /screenshot-contributie-overzicht.webp 1920w" sizes="(max-width: 768px) 400px, (max-width: 1024px) 50vw, 640px" data-full="/screenshot-contributie-overzicht.webp" alt={lang === 'en' ? 'Dues overview' : 'Contributie overzicht'} class="hero-slide" data-index="2" width="480" height="268" loading="lazy" />
          <img src="/screenshot-teams-overzicht-small.webp" srcset="/screenshot-teams-overzicht-small.webp 480w, /screenshot-teams-overzicht-thumb.webp 960w, /screenshot-teams-overzicht.webp 1920w" sizes="(max-width: 768px) 400px, (max-width: 1024px) 50vw, 640px" data-full="/screenshot-teams-overzicht.webp" alt={lang === 'en' ? 'Teams overview' : 'Teams overzicht'} class="hero-slide" data-index="3" width="480" height="268" loading="lazy" />
          <img src="/screenshot-commissie-overzicht-small.webp" srcset="/screenshot-commissie-overzicht-small.webp 480w, /screenshot-commissie-overzicht-thumb.webp 960w, /screenshot-commissie-overzicht.webp 1920w" sizes="(max-width: 768px) 400px, (max-width: 1024px) 50vw, 640px" data-full="/screenshot-commissie-overzicht.webp" alt={lang === 'en' ? 'Committees overview' : 'Commissies overzicht'} class="hero-slide" data-index="4" width="480" height="268" loading="lazy" />
        </button>
        <div class="hero-dots">
          {[0,1,2,3,4].map(i => (
            <button class:list={['hero-dot', { active: i === 0 }]} data-index={i} type="button" aria-label={`${lang === 'en' ? 'Go to slide' : 'Ga naar slide'} ${i + 1}`}></button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Lightbox overlay -->
<div class="lightbox" id="lightbox" role="dialog" aria-label={lang === 'en' ? 'Enlarged screenshot' : 'Screenshot vergroot'} aria-modal="true">
  <button class="lightbox-close" id="lightbox-close" type="button" aria-label={lang === 'en' ? 'Close' : 'Sluiten'}>&times;</button>
  <img src="" alt="" class="lightbox-img" id="lightbox-img" />
</div>

<script>
  const trigger = document.getElementById('screenshot-trigger');
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.getElementById('lightbox-close');
  const slides = document.querySelectorAll<HTMLImageElement>('.hero-slide');
  const dots = document.querySelectorAll('.hero-dot');
  const heroScreenshot = document.querySelector('.hero-screenshot');

  let currentIndex = 0;
  let rotationInterval: ReturnType<typeof setInterval> | null = null;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function showSlide(index: number) {
    slides.forEach((slide, i) => {
      slide.classList.toggle('active', i === index);
    });
    dots.forEach((dot, i) => {
      dot.classList.toggle('active', i === index);
    });
    currentIndex = index;
  }

  function nextSlide() {
    showSlide((currentIndex + 1) % slides.length);
  }

  function startRotation() {
    if (!prefersReducedMotion) {
      rotationInterval = setInterval(nextSlide, 4000);
    }
  }

  function stopRotation() {
    if (rotationInterval) {
      clearInterval(rotationInterval);
      rotationInterval = null;
    }
  }

  dots.forEach((dot, index) => {
    dot.addEventListener('click', (e) => {
      e.stopPropagation();
      showSlide(index);
      stopRotation();
      startRotation();
    });
  });

  heroScreenshot?.addEventListener('mouseenter', stopRotation);
  heroScreenshot?.addEventListener('mouseleave', startRotation);

  trigger?.addEventListener('click', () => {
    const currentSlide = slides[currentIndex];
    if (lightboxImg && currentSlide) {
      lightboxImg.src = currentSlide.dataset.full || currentSlide.src;
      lightboxImg.alt = currentSlide.alt;
    }
    lightbox?.classList.add('active');
    document.body.style.overflow = 'hidden';
  });

  function closeLightbox() {
    lightbox?.classList.remove('active');
    document.body.style.overflow = '';
  }

  closeBtn?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox?.classList.contains('active')) closeLightbox();
  });

  startRotation();
</script>

<style>
  .hero-section {
    display: flex;
    align-items: center;
    padding: 5rem 0 4rem;
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #F4FAFF 0%, #FFF6EF 100%);
  }

  .hero-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.4;
    pointer-events: none;
  }

  .hero-blob-1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(155, 194, 211, 0.9) 0%, transparent 70%);
    top: -200px;
    left: -100px;
  }

  .hero-blob-2 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(249, 149, 224, 0.8) 0%, transparent 70%);
    top: -100px;
    right: -150px;
  }

  .hero-blob-3 {
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(255, 226, 147, 0.85) 0%, transparent 72%);
    bottom: -170px;
    left: 28%;
  }

  .hero-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1rem;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-grid { grid-template-columns: 1fr 1fr; }
  }

  .hero-content { display: flex; flex-direction: column; }

  .hero-headline {
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }

  @media (min-width: 640px) { .hero-headline { font-size: 3rem; } }
  @media (min-width: 1024px) { .hero-headline { font-size: 3.75rem; } }

  .hero-subline {
    font-size: 1.125rem;
    color: var(--rondo-text-body);
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  @media (min-width: 1024px) { .hero-subline { font-size: 1.25rem; } }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .demo-hint {
    font-size: 0.8125rem;
    color: #6F84A8;
    margin-top: 0.75rem;
  }

  .demo-hint :global(strong) {
    color: #4E668F;
    font-weight: 600;
  }

  .hero-screenshot { width: 100%; }

  .screenshot-frame {
    display: block;
    width: 100%;
    border: none;
    padding: 0;
    border-radius: 1rem;
    box-shadow:
      0 25px 50px -12px rgba(0, 0, 0, 0.15),
      0 0 0 1px rgba(0, 27, 96, 0.12);
    background: #EDF4F8;
    overflow: hidden;
    cursor: zoom-in;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    position: relative;
    aspect-ratio: 16 / 9;
  }

  .screenshot-frame:hover {
    transform: scale(1.02);
    box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.2), 0 0 0 1px rgba(0, 0, 0, 0.1);
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.6s ease;
    display: block;
  }

  .hero-slide.active { opacity: 1; }

  .hero-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding: 0.4rem 0.65rem;
    width: fit-content;
    margin-inline: auto;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 8px 20px rgba(0, 27, 96, 0.12);
    border: 1px solid rgba(0, 27, 96, 0.12);
  }

  .hero-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid rgba(0, 27, 96, 0.28);
    padding: 0;
    cursor: pointer;
    background: #FFFFFF;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .hero-dot.active {
    border-color: transparent;
    background: var(--rondo-gradient-brand);
    transform: scale(1.15);
  }

  .hero-dot:focus-visible {
    outline: 2px solid var(--rondo-btn-primary);
    outline-offset: 2px;
  }

  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    align-items: center;
    justify-content: center;
    padding: 2rem;
    cursor: zoom-out;
  }

  .lightbox.active { display: flex; }

  .lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    border-radius: 0.75rem;
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5);
  }

  .lightbox-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
    font-size: 1.5rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .lightbox-close:hover { background: rgba(255, 255, 255, 0.4); }
</style>
