---
import Button from '../ui/Button.astro';
---

<section class="hero-section">
  <div class="hero-container">
    <div class="hero-grid">
      <!-- Left column: headline, subline, CTA -->
      <div class="hero-content">
        <h1 class="hero-headline">
          Klaar met verspreide ledengegevens?
        </h1>
        <p class="hero-subline">
          Rondo houdt ledendata, teams en communicatie overal synchroon — automatisch gekoppeld aan Sportlink.
        </p>
        <Button variant="primary" href="#product">
          Bekijk wat Rondo doet
        </Button>
      </div>

      <!-- Right column: product screenshot -->
      <div class="hero-screenshot">
        <button class="screenshot-frame" id="screenshot-trigger" type="button" aria-label="Vergroot screenshot">
          <img
            src="/rondo-club-screenshot.png"
            alt="Rondo Club dashboard met ledenlijst en teamoverzicht"
            class="screenshot-img"
            loading="eager"
          />
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Lightbox overlay -->
<div class="lightbox" id="lightbox" role="dialog" aria-label="Screenshot vergroot" aria-modal="true">
  <button class="lightbox-close" id="lightbox-close" type="button" aria-label="Sluiten">&times;</button>
  <img
    src="/rondo-club-screenshot.png"
    alt="Rondo Club dashboard met ledenlijst en teamoverzicht"
    class="lightbox-img"
  />
</div>

<script>
  const trigger = document.getElementById('screenshot-trigger');
  const lightbox = document.getElementById('lightbox');
  const closeBtn = document.getElementById('lightbox-close');

  trigger?.addEventListener('click', () => {
    lightbox?.classList.add('active');
    document.body.style.overflow = 'hidden';
  });

  function closeLightbox() {
    lightbox?.classList.remove('active');
    document.body.style.overflow = '';
  }

  closeBtn?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox?.classList.contains('active')) closeLightbox();
  });
</script>

<style>
  .hero-section {
    display: flex;
    align-items: center;
    padding: 5rem 0 4rem;
  }

  .hero-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1rem;
    width: 100%;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
  }

  .hero-headline {
    font-size: 2.25rem;
    font-weight: 700;
    color: white;
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }

  @media (min-width: 640px) {
    .hero-headline {
      font-size: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-headline {
      font-size: 3.75rem;
    }
  }

  .hero-subline {
    font-size: 1.125rem;
    color: #D1D5DB;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  @media (min-width: 1024px) {
    .hero-subline {
      font-size: 1.25rem;
    }
  }

  .hero-screenshot {
    width: 100%;
  }

  .screenshot-frame {
    border: none;
    padding: 0;
    border-radius: 1rem;
    box-shadow:
      0 25px 50px -12px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    overflow: hidden;
    cursor: zoom-in;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .screenshot-frame:hover {
    transform: scale(1.02);
    box-shadow:
      0 30px 60px -15px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(255, 255, 255, 0.15);
  }

  .screenshot-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    align-items: center;
    justify-content: center;
    padding: 2rem;
    cursor: zoom-out;
  }

  .lightbox.active {
    display: flex;
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    border-radius: 0.75rem;
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5);
  }

  .lightbox-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    font-size: 1.5rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.2);
  }
</style>
