---
import type { Lang } from '../../i18n/utils';
import { getLangFromUrl } from '../../i18n/utils';
import { t } from '../../i18n/translations';

interface Props { lang?: Lang; }
const lang = Astro.props.lang || getLangFromUrl(Astro.url);
---

<section id="integratie" class="pt-10 pb-20">
  <div class="max-w-5xl mx-auto px-4 mobile-px">
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-bold gradient-text mb-4">
        {t('integration.heading', lang)}
      </h2>
      <p class="text-xl text-slate-600">
        {t('integration.subheading', lang)}
      </p>
    </div>

    <div class="diagram-container">
      <svg viewBox="40 10 720 480" class="w-full h-auto max-w-3xl mx-auto" role="img" aria-label="Integration diagram showing data flow between systems">
        <defs>
          <linearGradient id="node-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#29A09C" />
            <stop offset="100%" stop-color="#602D91" />
          </linearGradient>
          <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="8" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
          </filter>
        </defs>

        <rect x="80" y="30" width="160" height="80" rx="12" class="diagram-node" />
        <text x="160" y="75" class="diagram-text">Sportlink Club</text>

        <rect x="560" y="30" width="160" height="80" rx="12" class="diagram-node" />
        <text x="640" y="75" class="diagram-text">Nikki</text>

        <rect x="80" y="210" width="160" height="80" rx="12" fill="url(#node-gradient)" opacity="0.15" filter="url(#glow)" />
        <rect x="80" y="210" width="160" height="80" rx="12" class="diagram-node-primary" />
        <text x="160" y="255" class="diagram-text-primary">Rondo Sync</text>

        <rect x="560" y="210" width="160" height="80" rx="12" fill="url(#node-gradient)" opacity="0.15" filter="url(#glow)" />
        <rect x="560" y="210" width="160" height="80" rx="12" class="diagram-node-primary" />
        <text x="640" y="255" class="diagram-text-primary">Rondo Club</text>

        <rect x="80" y="390" width="160" height="80" rx="12" class="diagram-node" />
        <text x="160" y="435" class="diagram-text">Laposta</text>

        <rect x="560" y="390" width="160" height="80" rx="12" class="diagram-node" />
        <text x="640" y="435" class="diagram-text">FreeScout</text>

        <path d="M 160 110 L 160 210" class="diagram-arrow" />
        <circle r="4" fill="#6ABAB8" opacity="0.9">
          <animateMotion dur="2.5s" repeatCount="indefinite" path="M 160 110 L 160 210" />
        </circle>
        <circle r="4" fill="#9C298C" opacity="0.9">
          <animateMotion dur="3s" repeatCount="indefinite" path="M 160 210 L 160 110" />
        </circle>
        <text x="170" y="165" fill="#6ABAB8" opacity="0.9" font-size="12" text-anchor="start">{t('integration.label.memberdata', lang)}</text>

        <path d="M 560 90 L 240 235" class="diagram-arrow" />
        <circle r="4" fill="#6ABAB8" opacity="0.9">
          <animateMotion dur="3s" repeatCount="indefinite" path="M 560 90 L 240 235" />
        </circle>
        <text x="420" y="165" fill="#6ABAB8" opacity="0.9" font-size="12" text-anchor="start">{t('integration.label.duesdata', lang)}</text>

        <path d="M 240 250 L 560 250" class="diagram-arrow" />
        <circle r="4" fill="#6ABAB8" opacity="0.9">
          <animateMotion dur="2s" repeatCount="indefinite" path="M 240 250 L 560 250" />
        </circle>
        <circle r="4" fill="#6ABAB8" opacity="0.9">
          <animateMotion dur="2s" begin="1s" repeatCount="indefinite" path="M 240 250 L 560 250" />
        </circle>
        <circle r="4" fill="#9C298C" opacity="0.9">
          <animateMotion dur="3s" repeatCount="indefinite" path="M 560 250 L 240 250" />
        </circle>

        <path d="M 160 290 L 160 390" class="diagram-arrow" />
        <circle r="4" fill="#6ABAB8" opacity="0.9">
          <animateMotion dur="2.5s" repeatCount="indefinite" path="M 160 290 L 160 390" />
        </circle>
        <text x="170" y="345" fill="#6ABAB8" opacity="0.9" font-size="12" text-anchor="start">{t('integration.label.memberdata', lang)}</text>

        <path d="M 240 270 L 560 420" class="diagram-arrow" />
        <circle r="4" fill="#6ABAB8" opacity="0.9">
          <animateMotion dur="3.5s" repeatCount="indefinite" path="M 240 270 L 560 420" />
        </circle>
        <circle r="4" fill="#9C298C" opacity="0.9">
          <animateMotion dur="4s" repeatCount="indefinite" path="M 560 420 L 240 270" />
        </circle>
        <text x="287" y="330" fill="#6ABAB8" opacity="0.9" font-size="12" text-anchor="start">{t('integration.label.memberdata', lang)}</text>
        <text x="485" y="380" fill="#9C298C" opacity="0.9" font-size="12" text-anchor="start">{t('integration.label.contacts', lang)}</text>
      </svg>
    </div>

    <div class="explanation">
      <div class="explanation-grid">
        <div class="explanation-card">
          <h3>Sportlink Club</h3>
          <p set:html={t('integration.sportlink.desc', lang)} />
        </div>
        <div class="explanation-card">
          <h3>Rondo Sync</h3>
          <p set:html={t('integration.sync.desc', lang)} />
        </div>
        <div class="explanation-card">
          <h3>Rondo Club</h3>
          <p set:html={t('integration.club.desc', lang)} />
        </div>
        <div class="explanation-card">
          <h3>Laposta</h3>
          <p set:html={t('integration.laposta.desc', lang)} />
        </div>
        <div class="explanation-card">
          <h3>FreeScout</h3>
          <p set:html={t('integration.freescout.desc', lang)} />
        </div>
        <div class="explanation-card">
          <h3>Nikki</h3>
          <p set:html={t('integration.nikki.desc', lang)} />
        </div>
      </div>

      <div class="bonden">
        <h3 class="bonden-heading">{t('integration.federations', lang)}</h3>
        <div class="bonden-logos">
          <img src="/bonden/knvb.webp" alt="KNVB" title="KNVB — Voetbal" width="296" height="296" loading="lazy" />
          <img src="/bonden/nhv.webp" alt="NHV" title="NHV — Handbal" width="296" height="296" loading="lazy" />
          <img src="/bonden/knzb.webp" alt="KNZB" title="KNZB — Zwemmen" width="296" height="296" loading="lazy" />
          <img src="/bonden/knkv.webp" alt="KNKV" title="KNKV — Korfbal" width="296" height="296" loading="lazy" />
          <img src="/bonden/nevobo.webp" alt="Nevobo" title="Nevobo — Volleybal" width="296" height="296" loading="lazy" />
          <img src="/bonden/knbsb.webp" alt="KNBSB" title="KNBSB — Honkbal & Softbal" width="296" height="296" loading="lazy" />
          <img src="/bonden/atletiekunie.webp" alt="Atletiekunie" title="Atletiekunie" width="296" height="296" loading="lazy" />
          <img src="/bonden/reddingsbrigade.webp" alt="Reddingsbrigade" title="Reddingsbrigade" width="300" height="296" loading="lazy" />
          <img src="/bonden/hockey-belgium.webp" alt="Hockey Belgium" title="Hockey Belgium" width="296" height="296" loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .diagram-container {
    background: #001B60;
    border-radius: 1.5rem;
    padding: 2.5rem 2rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
    position: relative;
    overflow: hidden;
  }

  .diagram-container::before {
    content: '';
    position: absolute;
    top: -100px;
    left: -100px;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(8, 145, 178, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .diagram-container::after {
    content: '';
    position: absolute;
    bottom: -100px;
    right: -100px;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.1) 0%, transparent 70%);
    pointer-events: none;
  }

  .diagram-node {
    fill: rgba(255, 255, 255, 0.06);
    stroke: rgba(255, 255, 255, 0.15);
    stroke-width: 1.5;
  }

  .diagram-node-primary {
    fill: rgba(8, 145, 178, 0.12);
    stroke: url(#node-gradient);
    stroke-width: 2;
  }

  .diagram-text {
    fill: #94A3B8;
    font-size: 16px;
    font-weight: 700;
    text-anchor: middle;
    dominant-baseline: middle;
  }

  .diagram-text-primary {
    fill: #EDF4F8;
    font-size: 16px;
    font-weight: 700;
    text-anchor: middle;
    dominant-baseline: middle;
  }

  .diagram-label {
    fill: rgba(255, 255, 255, 0.4);
    font-size: 12px;
    text-anchor: start;
  }

  .diagram-arrow {
    stroke: rgba(34, 211, 238, 0.3);
    stroke-width: 2;
    fill: none;
  }

  .explanation {
    margin-top: 3rem;
  }

  .explanation-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .explanation-card {
    padding: 1.5rem;
    background: rgba(0, 0, 0, 0.01);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 0.75rem;
    border-top: 2px solid transparent;
    position: relative;
    overflow: hidden;
  }

  .explanation-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(to right, #29A09C, #602D91);
  }

  .explanation-card h3 {
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
  }

  .explanation-card p {
    color: #475569;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .bonden {
    margin-top: 3rem;
    text-align: center;
  }

  .bonden-heading {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    color: #001B60;
    margin-bottom: 1.5rem;
  }

  .bonden-logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    align-items: center;
  }

  .bonden-logos img {
    height: 8.5rem;
    width: auto;
    opacity: 0.5;
    transition: opacity 0.2s ease-in-out;
  }

  .bonden-logos img:hover {
    opacity: 1;
  }

  /* Mobile: slightly smaller text */
  @media (max-width: 768px) {
    .diagram-text, .diagram-text-primary { font-size: 14px; }
    .mobile-px { padding-left: 0.25rem; padding-right: 0.25rem; }
    .diagram-container { padding: 1.5rem 0.75rem; border-radius: 1rem; }
    .explanation-grid { grid-template-columns: 1fr; }
  }
</style>
