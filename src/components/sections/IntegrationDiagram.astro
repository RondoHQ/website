---
import type { Lang } from '../../i18n/utils';
import { getLangFromUrl } from '../../i18n/utils';
import { t } from '../../i18n/translations';

interface Props { lang?: Lang; }
const lang = Astro.props.lang || getLangFromUrl(Astro.url);
---

<section id="integratie" class="pt-10 pb-20">
  <div class="max-w-5xl mx-auto px-4 mobile-px">
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-bold gradient-text mb-4">
        {t('integration.heading', lang)}
      </h2>
      <p class="text-xl text-slate-600">
        {t('integration.subheading', lang)}
      </p>
    </div>

    <div class="diagram-container">
      <svg viewBox="0 0 860 460" class="w-full h-auto max-w-4xl mx-auto" role="img" aria-label="Integration diagram showing data flow between systems">
        <defs>
          <linearGradient id="node-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#71DBA8" />
            <stop offset="100%" stop-color="#993399" />
          </linearGradient>
          <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="8" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
          </filter>
        </defs>

        <!-- Nodes: top row -->
        <rect x="30" y="30" width="160" height="80" rx="12" class="diagram-node" />
        <text x="110" y="75" class="diagram-text">Sportlink Club</text>

        <rect x="250" y="30" width="160" height="80" rx="12" class="diagram-node" />
        <text x="330" y="75" class="diagram-text">Nikki</text>

        <rect x="470" y="30" width="160" height="80" rx="12" class="diagram-node" />
        <text x="550" y="75" class="diagram-text">Sponsit</text>

        <!-- Nodes: middle row -->
        <rect x="100" y="190" width="160" height="80" rx="12" fill="url(#node-gradient)" opacity="0.15" filter="url(#glow)" />
        <rect x="100" y="190" width="160" height="80" rx="12" class="diagram-node-primary" />
        <text x="180" y="235" class="diagram-text-primary">Rondo Sync</text>

        <rect x="370" y="190" width="160" height="80" rx="12" fill="url(#node-gradient)" opacity="0.15" filter="url(#glow)" />
        <rect x="370" y="190" width="160" height="80" rx="12" class="diagram-node-primary" />
        <text x="450" y="235" class="diagram-text-primary">Rondo Club</text>

        <rect x="640" y="190" width="160" height="80" rx="12" class="diagram-node" />
        <text x="720" y="235" class="diagram-text">Mollie</text>

        <!-- Nodes: bottom row -->
        <rect x="30" y="355" width="160" height="80" rx="12" class="diagram-node" />
        <text x="110" y="400" class="diagram-text">Laposta</text>

        <rect x="250" y="355" width="160" height="80" rx="12" class="diagram-node" />
        <text x="330" y="400" class="diagram-text">FreeScout</text>

        <rect x="640" y="355" width="160" height="80" rx="12" class="diagram-node" />
        <text x="720" y="400" class="diagram-text">Lettermint</text>

        <!-- Arrow: Sportlink ↔ Rondo Sync -->
        <path d="M 110 110 L 165 190" class="diagram-arrow" />
        <circle r="4" fill="#71DBA8" opacity="0.9">
          <animateMotion dur="2.5s" repeatCount="indefinite" path="M 110 110 L 165 190" />
        </circle>
        <circle r="4" fill="#993399" opacity="0.9">
          <animateMotion dur="3s" repeatCount="indefinite" path="M 165 190 L 110 110" />
        </circle>
        <text x="115" y="155" fill="#71DBA8" opacity="0.9" font-size="12" text-anchor="start">{t('integration.label.memberdata', lang)}</text>

        <!-- Arrow: Nikki → Rondo Sync -->
        <path d="M 330 110 L 220 190" class="diagram-arrow" />
        <circle r="4" fill="#71DBA8" opacity="0.9">
          <animateMotion dur="3s" repeatCount="indefinite" path="M 330 110 L 220 190" />
        </circle>
        <text x="285" y="145" fill="#71DBA8" opacity="0.9" font-size="12" text-anchor="start">{t('integration.label.duesdata', lang)}</text>

        <!-- Arrow: Sponsit → Rondo Sync -->
        <path d="M 520 110 L 255 190" class="diagram-arrow" />
        <circle r="4" fill="#71DBA8" opacity="0.9">
          <animateMotion dur="3.5s" repeatCount="indefinite" path="M 520 110 L 255 190" />
        </circle>
        <text x="440" y="145" fill="#71DBA8" opacity="0.9" font-size="12" text-anchor="start">{t('integration.label.sponsordata', lang)}</text>

        <!-- Arrow: Rondo Sync ↔ Rondo Club -->
        <path d="M 260 230 L 370 230" class="diagram-arrow" />
        <circle r="4" fill="#71DBA8" opacity="0.9">
          <animateMotion dur="2s" repeatCount="indefinite" path="M 260 230 L 370 230" />
        </circle>
        <circle r="4" fill="#71DBA8" opacity="0.9">
          <animateMotion dur="2s" begin="1s" repeatCount="indefinite" path="M 260 230 L 370 230" />
        </circle>
        <circle r="4" fill="#993399" opacity="0.9">
          <animateMotion dur="3s" repeatCount="indefinite" path="M 370 230 L 260 230" />
        </circle>

        <!-- Arrow: Rondo Sync ↔ Laposta -->
        <path d="M 165 270 L 120 355" class="diagram-arrow" />
        <circle r="4" fill="#71DBA8" opacity="0.9">
          <animateMotion dur="2.5s" repeatCount="indefinite" path="M 165 270 L 120 355" />
        </circle>
        <circle r="4" fill="#993399" opacity="0.9">
          <animateMotion dur="3s" repeatCount="indefinite" path="M 120 355 L 165 270" />
        </circle>
        <text x="120" y="318" fill="#71DBA8" opacity="0.9" font-size="12" text-anchor="start">{t('integration.label.memberdata', lang)}</text>

        <!-- Arrow: Rondo Sync ↔ FreeScout -->
        <path d="M 220 270 L 310 355" class="diagram-arrow" />
        <circle r="4" fill="#71DBA8" opacity="0.9">
          <animateMotion dur="3s" repeatCount="indefinite" path="M 220 270 L 310 355" />
        </circle>
        <circle r="4" fill="#993399" opacity="0.9">
          <animateMotion dur="3.5s" repeatCount="indefinite" path="M 310 355 L 220 270" />
        </circle>
        <text x="235" y="305" fill="#71DBA8" opacity="0.9" font-size="12" text-anchor="start">{t('integration.label.memberdata', lang)}</text>
        <text x="285" y="325" fill="#C77DFF" opacity="0.9" font-size="12" text-anchor="start">{t('integration.label.contacts', lang)}</text>

        <!-- Arrow: Rondo Club ↔ Mollie -->
        <path d="M 530 230 L 640 230" class="diagram-arrow" />
        <circle r="4" fill="#71DBA8" opacity="0.9">
          <animateMotion dur="2s" repeatCount="indefinite" path="M 530 230 L 640 230" />
        </circle>
        <circle r="4" fill="#993399" opacity="0.9">
          <animateMotion dur="2.5s" repeatCount="indefinite" path="M 640 230 L 530 230" />
        </circle>
        <text x="585" y="218" fill="#71DBA8" opacity="0.9" font-size="12" text-anchor="middle">{t('integration.label.payments', lang)}</text>

        <!-- Arrow: Rondo Club ↔ Lettermint -->
        <path d="M 490 270 L 644 358" class="diagram-arrow" />
        <circle r="4" fill="#71DBA8" opacity="0.9">
          <animateMotion dur="3s" repeatCount="indefinite" path="M 490 270 L 644 358" />
        </circle>
        <circle r="4" fill="#993399" opacity="0.9">
          <animateMotion dur="3.5s" repeatCount="indefinite" path="M 644 358 L 490 270" />
        </circle>
        <text x="575" y="305" fill="#71DBA8" opacity="0.9" font-size="12" text-anchor="middle">{t('integration.label.emails', lang)}</text>
      </svg>
    </div>

    <div class="explanation">
      <div class="explanation-grid">
        <div class="explanation-card">
          <h3>Sportlink Club</h3>
          <p set:html={t('integration.sportlink.desc', lang)} />
        </div>
        <div class="explanation-card">
          <h3>Rondo Sync</h3>
          <p set:html={t('integration.sync.desc', lang)} />
        </div>
        <div class="explanation-card">
          <h3>Rondo Club</h3>
          <p set:html={t('integration.club.desc', lang)} />
        </div>
        <div class="explanation-card">
          <h3>Laposta</h3>
          <p set:html={t('integration.laposta.desc', lang)} />
        </div>
        <div class="explanation-card">
          <h3>FreeScout</h3>
          <p set:html={t('integration.freescout.desc', lang)} />
        </div>
        <div class="explanation-card">
          <h3>Mollie</h3>
          <p set:html={t('integration.mollie.desc', lang)} />
        </div>
        <div class="explanation-card">
          <h3>Lettermint</h3>
          <p set:html={t('integration.lettermint.desc', lang)} />
        </div>
        <div class="explanation-card">
          <h3>Nikki</h3>
          <p set:html={t('integration.nikki.desc', lang)} />
        </div>
        <div class="explanation-card">
          <h3>Sponsit</h3>
          <p set:html={t('integration.sponsit.desc', lang)} />
        </div>
      </div>

      <div class="bonden">
        <h3 class="bonden-heading">{t('integration.federations', lang)}</h3>
        <p class="bonden-subline">{t('integration.federations.note', lang)}</p>
        <div class="bonden-logos">
          <img src="/bonden/knvb.webp" alt="KNVB" title="KNVB — Voetbal" width="296" height="296" loading="lazy" />
          <img src="/bonden/nhv.webp" alt="NHV" title="NHV — Handbal" width="296" height="296" loading="lazy" />
          <img src="/bonden/knzb.webp" alt="KNZB" title="KNZB — Zwemmen" width="296" height="296" loading="lazy" />
          <img src="/bonden/knkv.webp" alt="KNKV" title="KNKV — Korfbal" width="296" height="296" loading="lazy" />
          <img src="/bonden/nevobo.webp" alt="Nevobo" title="Nevobo — Volleybal" width="296" height="296" loading="lazy" />
          <img src="/bonden/knbsb.webp" alt="KNBSB" title="KNBSB — Honkbal & Softbal" width="296" height="296" loading="lazy" />
          <img src="/bonden/atletiekunie.webp" alt="Atletiekunie" title="Atletiekunie" width="296" height="296" loading="lazy" />
          <img src="/bonden/reddingsbrigade.webp" alt="Reddingsbrigade" title="Reddingsbrigade" width="300" height="296" loading="lazy" />
          <img src="/bonden/hockey-belgium.webp" alt="Hockey Belgium" title="Hockey Belgium" width="296" height="296" loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .diagram-container {
    background: #001B60;
    border-radius: 1.5rem;
    padding: 2.5rem 2rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
    position: relative;
    overflow: hidden;
  }

  .diagram-container::before {
    content: '';
    position: absolute;
    top: -100px;
    left: -100px;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(8, 145, 178, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .diagram-container::after {
    content: '';
    position: absolute;
    bottom: -100px;
    right: -100px;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(153, 51, 153, 0.1) 0%, transparent 70%);
    pointer-events: none;
  }

  .diagram-node {
    fill: rgba(255, 255, 255, 0.06);
    stroke: rgba(255, 255, 255, 0.15);
    stroke-width: 1.5;
  }

  .diagram-node-primary {
    fill: rgba(8, 145, 178, 0.12);
    stroke: url(#node-gradient);
    stroke-width: 2;
  }

  .diagram-text {
    fill: #94A3B8;
    font-size: 16px;
    font-weight: 700;
    text-anchor: middle;
    dominant-baseline: middle;
  }

  .diagram-text-primary {
    fill: #EDF4F8;
    font-size: 16px;
    font-weight: 700;
    text-anchor: middle;
    dominant-baseline: middle;
  }

  .diagram-label {
    fill: rgba(255, 255, 255, 0.4);
    font-size: 12px;
    text-anchor: start;
  }

  .diagram-arrow {
    stroke: rgba(113, 219, 168, 0.35);
    stroke-width: 2;
    fill: none;
  }

  .explanation {
    margin-top: 3rem;
  }

  .explanation-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .explanation-card {
    padding: 1.5rem;
    background: rgba(0, 0, 0, 0.01);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 0.75rem;
    border-top: 2px solid transparent;
    position: relative;
    overflow: hidden;
  }

  .explanation-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(to right, #71DBA8, #993399);
  }

  .explanation-card h3 {
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
  }

  .explanation-card p {
    color: #475569;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .bonden {
    margin-top: 3rem;
    text-align: center;
  }

  .bonden-heading {
    font-family: 'Figtree', sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    color: #001B60;
    margin-bottom: 0.5rem;
  }

  .bonden-subline {
    color: #475569;
    font-size: 1rem;
    margin: 0 auto 1.5rem;
    max-width: 40rem;
  }

  .bonden-logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    align-items: center;
  }

  .bonden-logos img {
    height: 8.5rem;
    width: auto;
    opacity: 0.5;
    transition: opacity 0.2s ease-in-out;
  }

  .bonden-logos img:hover {
    opacity: 1;
  }

  /* Mobile: slightly smaller text */
  @media (max-width: 768px) {
    .diagram-text, .diagram-text-primary { font-size: 14px; }
    .mobile-px { padding-left: 0.25rem; padding-right: 0.25rem; }
    .diagram-container { padding: 1.5rem 0.75rem; border-radius: 1rem; }
    .explanation-grid { grid-template-columns: 1fr; }
  }
</style>
