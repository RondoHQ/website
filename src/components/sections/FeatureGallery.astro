          <img src="/screenshot-persoons-detail-scherm-tucht-small.webp" srcset="/screenshot-persoons-detail-scherm-tucht-small.webp 480w, /screenshot-persoons-detail-scherm-tucht-thumb.webp 960w, /screenshot-persoons-detail-scherm-tucht.webp 1920w" sizes="(max-width: 768px) 480px, 560px" width="480" height="268" alt={t('gallery.caption.disciplinaryPerson', lang)} loading="lazy" />
