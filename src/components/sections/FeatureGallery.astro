---
import type { Lang } from '../../i18n/utils';
import { getLangFromUrl } from '../../i18n/utils';
import { t } from '../../i18n/translations';

interface Props { lang?: Lang; }
const lang = Astro.props.lang || getLangFromUrl(Astro.url);
---

<section id="features" class="py-20 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-bold gradient-text mb-4">
        {t('gallery.heading', lang)}
      </h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto">
        {t('gallery.subheading', lang)}
      </p>
    </div>

    <div class="tab-bar-wrapper">
      <div class="tab-bar">
        <button class="tab-button active" data-category="leden" type="button">{t('gallery.tab.members', lang)}</button>
        <button class="tab-button" data-category="jubilarissen" type="button">{t('gallery.tab.jubilees', lang)}</button>
        <button class="tab-button" data-category="kaderlijst" type="button">{t('gallery.tab.staffList', lang)}</button>
        <button class="tab-button" data-category="contributie" type="button">{t('gallery.tab.dues', lang)}</button>
        <button class="tab-button" data-category="finance" type="button">{t('gallery.tab.finance', lang)}</button>
        <button class="tab-button" data-category="access" type="button">{t('gallery.tab.access', lang)}</button>
        <button class="tab-button" data-category="vog" type="button">{t('gallery.tab.vog', lang)}</button>
        <button class="tab-button" data-category="teams" type="button">{t('gallery.tab.teams', lang)}</button>
        <button class="tab-button" data-category="commissies" type="button">{t('gallery.tab.committees', lang)}</button>
        <button class="tab-button" data-category="tuchtzaken" type="button">{t('gallery.tab.disciplinary', lang)}</button>
      </div>
    </div>

    <div class="mt-8">
      <div class="screenshot-grid" data-category="leden">
        <button class="screenshot-item" data-screenshot="/screenshot-leden-lijst.webp" type="button">
          <img src="/screenshot-leden-lijst-small.webp" srcset="/screenshot-leden-lijst-small.webp 480w, /screenshot-leden-lijst-thumb.webp 960w, /screenshot-leden-lijst.webp 1920w" sizes="(max-width: 768px) 480px, 560px" width="480" height="267" alt={t('gallery.caption.memberList', lang)} loading="lazy" />
          <p class="screenshot-caption">{t('gallery.caption.memberList', lang)}</p>
        </button>
        <button class="screenshot-item" data-screenshot="/screenshot-persoons-detail-scherm.webp" type="button">
          <img src="/screenshot-persoons-detail-scherm-small.webp" srcset="/screenshot-persoons-detail-scherm-small.webp 480w, /screenshot-persoons-detail-scherm-thumb.webp 960w, /screenshot-persoons-detail-scherm.webp 1920w" sizes="(max-width: 768px) 480px, 560px" width="480" height="268" alt={t('gallery.caption.personDetail', lang)} loading="lazy" />
          <p class="screenshot-caption">{t('gallery.caption.personDetail', lang)}</p>
        </button>
      </div>

      <div class="screenshot-grid" data-category="jubilarissen" style="display: none;">
        <button class="screenshot-item" data-screenshot="/jubilarissen-filter.webp" type="button">
          <img src="/jubilarissen-filter.webp" width="3456" height="1922" alt={t('gallery.caption.jubileesFilter', lang)} loading="lazy" />
          <p class="screenshot-caption">{t('gallery.caption.jubileesFilter', lang)}</p>
        </button>
        <button class="screenshot-item" data-screenshot="/jubilarissen-vrijwilligers.webp" type="button">
