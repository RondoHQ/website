      </div>

      <div class="screenshot-grid" data-category="access" style="display: none;">
        <button class="screenshot-item" data-screenshot="/screenshot-ledenpas-apple-awc.webp" type="button">
          <img src="/screenshot-ledenpas-apple-awc.webp" width="1206" height="1637" alt={t('gallery.caption.accessAppleAwc', lang)} loading="lazy" />
          <p class="screenshot-caption">{t('gallery.caption.accessAppleAwc', lang)}</p>
        </button>
        <button class="screenshot-item" data-screenshot="/screenshot-ledenpas-google-awc.webp" type="button">
          <img src="/screenshot-ledenpas-google-awc.webp" width="752" height="1264" alt={t('gallery.caption.accessGoogleAwc', lang)} loading="lazy" />
          <p class="screenshot-caption">{t('gallery.caption.accessGoogleAwc', lang)}</p>
        </button>
        <button class="screenshot-item" data-screenshot="/screenshot-ledenpas-scanner-awc.webp" type="button">
          <img src="/screenshot-ledenpas-scanner-awc.webp" width="1206" height="2052" alt={t('gallery.caption.accessScannerAwc', lang)} loading="lazy" />
          <p class="screenshot-caption">{t('gallery.caption.accessScannerAwc', lang)}</p>
        </button>
      </div>

      <div class="screenshot-grid" data-category="vog" style="display: none;">
        <button class="screenshot-item" data-screenshot="/screenshot-vog-overzicht.webp" type="button">
          <img src="/screenshot-vog-overzicht-small.webp" srcset="/screenshot-vog-overzicht-small.webp 480w, /screenshot-vog-overzicht-thumb.webp 960w, /screenshot-vog-overzicht.webp 1920w" sizes="(max-width: 768px) 480px, 560px" width="480" height="268" alt={t('gallery.caption.vogOverview', lang)} loading="lazy" />
          <p class="screenshot-caption">{t('gallery.caption.vogOverview', lang)}</p>
        </button>
        <button class="screenshot-item" data-screenshot="/screenshot-vog-acties.webp" type="button">
          <img src="/screenshot-vog-acties-small.webp" srcset="/screenshot-vog-acties-small.webp 480w, /screenshot-vog-acties-thumb.webp 960w, /screenshot-vog-acties.webp 1920w" sizes="(max-width: 768px) 480px, 560px" width="480" height="268" alt={t('gallery.caption.vogActions', lang)} loading="lazy" />
          <p class="screenshot-caption">{t('gallery.caption.vogActions', lang)}</p>
        </button>
      </div>

      <div class="screenshot-grid" data-category="teams" style="display: none;">
        <button class="screenshot-item" data-screenshot="/screenshot-teams-overzicht.webp" type="button">
          <img src="/screenshot-teams-overzicht-small.webp" srcset="/screenshot-teams-overzicht-small.webp 480w, /screenshot-teams-overzicht-thumb.webp 960w, /screenshot-teams-overzicht.webp 1920w" sizes="(max-width: 768px) 480px, 560px" width="480" height="268" alt={t('gallery.caption.teamsOverview', lang)} loading="lazy" />
          <p class="screenshot-caption">{t('gallery.caption.teamsOverview', lang)}</p>
        </button>
        <button class="screenshot-item" data-screenshot="/screenshot-team-detail.webp" type="button">
          <img src="/screenshot-team-detail-small.webp" srcset="/screenshot-team-detail-small.webp 480w, /screenshot-team-detail-thumb.webp 960w, /screenshot-team-detail.webp 1920w" sizes="(max-width: 768px) 480px, 560px" width="480" height="268" alt={t('gallery.caption.teamDetail', lang)} loading="lazy" />
          <p class="screenshot-caption">{t('gallery.caption.teamDetail', lang)}</p>
        </button>
        <button class="screenshot-item" data-screenshot="/teams-filter.webp" type="button">
          <img src="/teams-filter.webp" width="3456" height="1922" alt={t('gallery.caption.teamsFilter', lang)} loading="lazy" />
