      <div class="screenshot-grid" data-category="commissies" style="display: none;">
        <button class="screenshot-item" data-screenshot="/screenshot-commissie-overzicht.webp" type="button">
          <img src="/screenshot-commissie-overzicht-small.webp" srcset="/screenshot-commissie-overzicht-small.webp 480w, /screenshot-commissie-overzicht-thumb.webp 960w, /screenshot-commissie-overzicht.webp 1920w" sizes="(max-width: 768px) 480px, 560px" width="480" height="268" alt={t('gallery.caption.committeesOverview', lang)} loading="lazy" />
          <p class="screenshot-caption">{t('gallery.caption.committeesOverview', lang)}</p>
        </button>
        <button class="screenshot-item" data-screenshot="/screenshot-commissie-detail.webp" type="button">
          <img src="/screenshot-commissie-detail-small.webp" srcset="/screenshot-commissie-detail-small.webp 480w, /screenshot-commissie-detail-thumb.webp 960w, /screenshot-commissie-detail.webp 1920w" sizes="(max-width: 768px) 480px, 560px" width="480" height="268" alt={t('gallery.caption.committeeDetail', lang)} loading="lazy" />
