---
import GlassPanel from '../ui/GlassPanel.astro';
import Input from '../ui/Input.astro';
import Textarea from '../ui/Textarea.astro';
import Button from '../ui/Button.astro';
import type { Lang } from '../../i18n/utils';
import { getLangFromUrl } from '../../i18n/utils';
import { t } from '../../i18n/translations';

interface Props { lang?: Lang; }
const lang = Astro.props.lang || getLangFromUrl(Astro.url);
---

<section id="contact" class="py-20 px-4 contact-section">
  <div class="max-w-2xl mx-auto">
    <GlassPanel class="p-8 md:p-12">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-2">{t('contact.heading', lang)}</h2>
      <p class="text-slate-300 mb-8">{t('contact.subheading', lang)}</p>

      <form id="contact-form" method="POST" action="/api/contact" novalidate data-lang={lang}>
        <Input
          label={t('contact.name', lang)}
          name="name"
          type="text"
          required={true}
          placeholder={t('contact.name.placeholder', lang)}
          class="mb-4"
        />

        <Input
          label={t('contact.email', lang)}
          name="email"
          type="email"
          required={true}
          placeholder={t('contact.email.placeholder', lang)}
          class="mb-4"
        />

        <Input
          label={t('contact.club', lang)}
          name="club_name"
          type="text"
          required={true}
          placeholder={t('contact.club.placeholder', lang)}
          class="mb-4"
        />

        <Input
          label={t('contact.members', lang)}
          name="member_count"
          type="text"
          placeholder={t('contact.members.placeholder', lang)}
          class="mb-4"
        />

        <Textarea
          label={t('contact.message', lang)}
          name="message"
          placeholder={t('contact.message.placeholder', lang)}
          rows={4}
          class="mb-6"
        />

        <!-- Honeypot -->
        <div style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden" aria-hidden="true">
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <!-- Timestamp for speed check -->
        <input type="hidden" name="_t" id="form-timestamp" value="" />

        <div id="form-message" role="status" aria-live="polite" class="mb-4 hidden"></div>

        <Button type="submit" variant="primary" class="w-full md:w-auto">
          {t('contact.submit', lang)}
        </Button>
      </form>
    </GlassPanel>
  </div>
</section>

<script>
const form = document.getElementById('contact-form') as HTMLFormElement | null;
const messageDiv = document.getElementById('form-message');
const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement | undefined;
const timestampField = document.getElementById('form-timestamp') as HTMLInputElement | null;
const formLang = form?.dataset.lang || 'nl';

const msgs: Record<string, Record<string, string>> = {
  sending: { nl: 'Versturen...', en: 'Sending...' },
  success: { nl: 'Bedankt! We nemen zo snel mogelijk contact op.', en: "Thanks! We'll get back to you as soon as possible." },
  error: { nl: 'Er ging iets mis. Probeer het opnieuw.', en: 'Something went wrong. Please try again.' },
  errorRetry: { nl: 'Er ging iets mis. Probeer het later opnieuw.', en: 'Something went wrong. Please try again later.' },
  validation: { nl: 'Vul alle verplichte velden in (naam, e-mail, clubnaam).', en: 'Please fill in all required fields (name, email, club name).' },
  validEmail: { nl: 'Vul een geldig e-mailadres in.', en: 'Please enter a valid email address.' },
};

function msg(key: string): string { return msgs[key]?.[formLang] || msgs[key]?.['nl'] || ''; }

if (timestampField) timestampField.value = String(Date.now());

form?.addEventListener('submit', async (e) => {
  e.preventDefault();

  const originalText = submitButton?.textContent || '';
  if (submitButton) {
    submitButton.disabled = true;
    submitButton.textContent = msg('sending');
  }
  messageDiv?.classList.add('hidden');

  const formData = new FormData(form);
  const name = formData.get('name')?.toString().trim() || '';
  const email = formData.get('email')?.toString().trim() || '';
  const clubName = formData.get('club_name')?.toString().trim() || '';

  if (!name || !email || !clubName) {
    showMessage(msg('validation'), true);
    resetButton();
    return;
  }

  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (!emailRegex.test(email)) {
    showMessage(msg('validEmail'), true);
    resetButton();
    return;
  }

  try {
    const response = await fetch('/api/contact', {
      method: 'POST',
      body: formData
    });

    const result = await response.json();

    if (response.ok && result.success) {
      (window as any).plausible('ContactFormSubmit', {
        props: {
          clubName: clubName,
          memberRange: formData.get('member_count')?.toString() || 'not-specified'
        }
      });
      showMessage(result.message || msg('success'), false);
      form.reset();
    } else {
      showMessage(result.error || msg('error'), true);
    }
  } catch (err) {
    showMessage(msg('errorRetry'), true);
  } finally {
    resetButton();
  }

  function showMessage(text: string, isError: boolean): void {
    if (!messageDiv) return;
    messageDiv.textContent = text;
    messageDiv.classList.remove('hidden');
    if (isError) {
      messageDiv.className = 'mb-4 p-4 rounded-lg border text-sm form-message-error';
    } else {
      messageDiv.className = 'mb-4 p-4 rounded-lg border text-sm form-message-success';
    }
  }

  function resetButton(): void {
    if (submitButton) {
      submitButton.disabled = false;
      submitButton.textContent = originalText;
    }
  }
});
</script>

<style>
.form-message-success {
  background: rgba(34, 197, 94, 0.1);
  border-color: rgba(34, 197, 94, 0.3);
  color: #166534;
}
.form-message-error {
  background: rgba(239, 68, 68, 0.1);
  border-color: rgba(239, 68, 68, 0.3);
  color: #FCA5A5;
}

.contact-section {
  background: #001B60;
}

.contact-section :global(.glass-panel) {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.1);
}

.contact-section :global(label) {
  color: #CBD5E1 !important;
}

.contact-section :global(.input-field),
.contact-section :global(.textarea-field) {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.15);
  color: #EDF4F8;
}

.contact-section :global(.input-field)::placeholder,
.contact-section :global(.textarea-field)::placeholder {
  color: #64748B;
}

.contact-section :global(.input-field):focus,
.contact-section :global(.textarea-field):focus {
  border-color: #6ABAB8;
  box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.15);
}

.form-message-success {
  color: #86EFAC;
}
</style>
