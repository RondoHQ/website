---
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import type { Lang } from '../../i18n/utils';
import { getLangFromUrl } from '../../i18n/utils';
import { t } from '../../i18n/translations';

interface Props { lang?: Lang; }
const lang = Astro.props.lang || getLangFromUrl(Astro.url);

const roleLinks = lang === 'en'
  ? {
      secretary: '/en/for-secretary/',
      treasurer: '/en/for-treasurer/',
      gate: '/en/for-gate-volunteer/',
      board: '/en/for-board-it/',
      support: '/en/for-member-administration/',
      communication: '/en/for-communication/',
      volunteers: '/en/for-volunteer-coordinator/',
      sponsors: '/en/for-sponsor-committee/',
      tournaments: '/en/for-tournament-coordinator/',
      clubTv: '/en/for-club-tv-editor/',
    }
  : {
      secretary: '/voor-secretaris/',
      treasurer: '/voor-penningmeester/',
      gate: '/voor-toegang/',
      board: '/voor-bestuur-ict/',
      support: '/voor-ledenadministratie/',
      communication: '/voor-communicatie/',
      volunteers: '/voor-vrijwilligerscoordinator/',
      sponsors: '/voor-sponsorcommissie/',
      tournaments: '/voor-toernooicoordinator/',
      clubTv: '/voor-club-tv-redacteur/',
    };
---

<section id="rollen" class="role-paths">
  <img class="role-art" width="511" height="520" src="/design/shape-orange.svg" alt="" aria-hidden="true" />
  <div class="rondo-container role-container">
    <div class="rondo-section-intro role-intro">
      <h2 >{t('roles.heading', lang)}</h2>
      <p >{t('roles.subheading', lang)}</p>
    </div>

    <div class="role-grid">
      <Card class="role-card" title={t('roles.secretary.title', lang)}>
        <p class="text-slate-600 mb-6">{t('roles.secretary.text', lang)}</p>
        <Button variant="outline" href={roleLinks.secretary}>{t('roles.secretary.cta', lang)}</Button>
      </Card>

      <Card class="role-card" title={t('roles.treasurer.title', lang)}>
        <p class="text-slate-600 mb-6">{t('roles.treasurer.text', lang)}</p>
        <Button variant="outline" href={roleLinks.treasurer}>{t('roles.treasurer.cta', lang)}</Button>
      </Card>

      <Card class="role-card" title={t('roles.gate.title', lang)}>
        <p class="text-slate-600 mb-6">{t('roles.gate.text', lang)}</p>
        <Button variant="outline" href={roleLinks.gate}>{t('roles.gate.cta', lang)}</Button>
      </Card>

      <Card class="role-card" title={t('roles.board.title', lang)}>
        <p class="text-slate-600 mb-6">{t('roles.board.text', lang)}</p>
        <Button variant="outline" href={roleLinks.board}>{t('roles.board.cta', lang)}</Button>
      </Card>

      <Card class="role-card" title={t('roles.support.title', lang)}>
        <p class="text-slate-600 mb-6">{t('roles.support.text', lang)}</p>
        <Button variant="outline" href={roleLinks.support}>{t('roles.support.cta', lang)}</Button>
      </Card>

      <Card class="role-card" title={t('roles.communication.title', lang)}>
        <p class="text-slate-600 mb-6">{t('roles.communication.text', lang)}</p>
        <Button variant="outline" href={roleLinks.communication}>{t('roles.communication.cta', lang)}</Button>
      </Card>

      <Card class="role-card" title={t('roles.volunteers.title', lang)}>
        <p class="text-slate-600 mb-6">{t('roles.volunteers.text', lang)}</p>
        <Button variant="outline" href={roleLinks.volunteers}>{t('roles.volunteers.cta', lang)}</Button>
      </Card>

      <Card class="role-card" title={t('roles.sponsors.title', lang)}>
        <p class="text-slate-600 mb-6">{t('roles.sponsors.text', lang)}</p>
        <Button variant="outline" href={roleLinks.sponsors}>{t('roles.sponsors.cta', lang)}</Button>
      </Card>

      <Card class="role-card" title={t('roles.tournaments.title', lang)}>
        <p class="text-slate-600 mb-6">{t('roles.tournaments.text', lang)}</p>
        <Button variant="outline" href={roleLinks.tournaments}>{t('roles.tournaments.cta', lang)}</Button>
      </Card>

      <Card class="role-card" title={t('roles.clubTv.title', lang)}>
        <p class="text-slate-600 mb-6">{t('roles.clubTv.text', lang)}</p>
        <Button variant="outline" href={roleLinks.clubTv}>{t('roles.clubTv.cta', lang)}</Button>
      </Card>
    </div>
  </div>
</section>

<style>
  .role-paths { position: relative; overflow: clip; background: white; padding: 64px 0 80px; }
  .role-art { position: absolute; top: -110px; left: calc(50% - 1005px); max-width: none; pointer-events: none; }
  .role-container { position: relative; }
  .role-intro { margin-bottom: 50px; }
  .role-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .role-grid :global(.role-card) { min-height: 240px; display: flex; flex-direction: column; align-items: start; }
  .role-grid :global(.role-card h3) { line-height: 1.1; }
  .role-grid :global(.role-card p) { color: var(--rondo-text-body); font-size: 18px; line-height: 1.3; margin-bottom: 20px; }
  .role-grid :global(.role-card a) { margin-top: auto; }
  @media (max-width: 1100px) { .role-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; } }
  @media (max-width: 600px) {
    .role-paths { padding: 48px 0; }
    .role-intro { margin-bottom: 32px; }
    .role-grid { grid-template-columns: 1fr; gap: 24px; }
    .role-art { left: -420px; opacity: .35; }
  }
</style>
