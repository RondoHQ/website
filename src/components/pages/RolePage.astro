---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../sections/Footer.astro';
import type { Lang } from '../../i18n/utils';

interface RoleCard {
  title: string;
  text: string;
}

interface RoleLink {
  href: string;
  label: string;
}

interface Props {
  lang: Lang;
  title: string;
  description: string;
  kicker: string;
  roleTitle: string;
  intro: string;
  demoLabel: string;
  contactLabel: string;
  contactHref: string;
  screenshotSrc: string;
  screenshotAlt: string;
  screenshotWidth: number;
  screenshotHeight: number;
  secondaryScreenshotSrc?: string;
  secondaryScreenshotAlt?: string;
  secondaryScreenshotWidth?: number;
  secondaryScreenshotHeight?: number;
  screenshotLayout?: 'default' | 'passWide';
  whatHeading: string;
  bulletPoints: string[];
  cards: RoleCard[];
  otherHeading: string;
  otherPrefix: string;
  otherAnd: string;
  otherLinks: [RoleLink, RoleLink];
  hasExtra?: boolean;
}

const {
  lang,
  title,
  description,
  kicker,
  roleTitle,
  intro,
  demoLabel,
  contactLabel,
  contactHref,
  screenshotSrc,
  screenshotAlt,
  screenshotWidth,
  screenshotHeight,
  secondaryScreenshotSrc,
  secondaryScreenshotAlt,
  secondaryScreenshotWidth,
  secondaryScreenshotHeight,
  screenshotLayout = 'default',
  whatHeading,
  bulletPoints,
  cards,
  otherHeading,
  otherPrefix,
  otherAnd,
  otherLinks,
  hasExtra = false,
} = Astro.props;

const [firstLink, secondLink] = otherLinks;
const hasSecondaryScreenshot = Boolean(secondaryScreenshotSrc);
const secondaryAlt = secondaryScreenshotAlt ?? screenshotAlt;
const secondaryWidth = secondaryScreenshotWidth ?? screenshotWidth;
const secondaryHeight = secondaryScreenshotHeight ?? screenshotHeight;
const isPassWideLayout = screenshotLayout === 'passWide';
const bottomCtaHeading = lang === 'en'
  ? 'Want to discuss what Rondo can do for your club?'
  : 'Wil je bespreken wat Rondo voor jullie club kan doen?';
const bottomCtaText = lang === 'en'
  ? 'Plan a short intro and we will map out the best setup for your workflow, volunteers and integrations.'
  : 'Plan een korte kennismaking en we denken mee over de beste inrichting voor jullie workflow, vrijwilligers en koppelingen.';

const currentUrl = `https://rondo.club${Astro.url.pathname}`;
const homeUrl = lang === 'en' ? 'https://rondo.club/en/' : 'https://rondo.club/';
const homeLabel = lang === 'en' ? 'Home' : 'Home';
const rolesLabel = lang === 'en' ? 'By role' : 'Voor jouw rol';
const breadcrumbs = [
  { name: homeLabel, url: homeUrl },
  { name: rolesLabel, url: homeUrl + '#roles' },
  { name: roleTitle, url: currentUrl },
];
---

<BaseLayout lang={lang} title={title} description={description} breadcrumbs={breadcrumbs}>
  <Header lang={lang} />
  <main id="main-content" class="role-page">
    <section class="role-hero">
      <div class="role-container role-grid">
        <div>
          <p class="role-kicker">{kicker}</p>
          <h1 class="gradient-text role-title">{roleTitle}</h1>
          <p class="role-intro">{intro}</p>
          <div class="role-actions">
            <a href="https://demo.rondo.club" class="role-btn role-btn-primary">{demoLabel}</a>
            <a href={contactHref} class="role-btn role-btn-outline">{contactLabel}</a>
          </div>
        </div>
        <div class:list={['role-shot', { 'role-shot-multi': hasSecondaryScreenshot, 'role-shot-pass-wide': hasSecondaryScreenshot && isPassWideLayout }]}>
          {hasSecondaryScreenshot ? (
            <div class="role-shot-grid">
              <img class="zoomable-screenshot" src={screenshotSrc} alt={screenshotAlt} width={screenshotWidth} height={screenshotHeight} loading="eager" />
              <img class="zoomable-screenshot" src={secondaryScreenshotSrc} alt={secondaryAlt} width={secondaryWidth} height={secondaryHeight} loading="eager" />
            </div>
          ) : (
            <img class="zoomable-screenshot" src={screenshotSrc} alt={screenshotAlt} width={screenshotWidth} height={screenshotHeight} loading="eager" />
          )}
        </div>
      </div>
    </section>

    <section class="role-section">
      <div class="role-container">
        <h2 class="gradient-text role-heading">{whatHeading}</h2>
        <ul class="role-list">
          {bulletPoints.map(point => <li>{point}</li>)}
        </ul>
      </div>
    </section>

    <section class="role-section">
      <div class="role-container role-cards">
        {cards.map(card => (
          <article class="role-card">
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
    </section>

    {hasExtra && (
      <section class="role-section role-extra">
        <slot />
      </section>
    )}

    <section class="role-section">
      <div class="role-container">
        <h2 class="gradient-text role-heading">{otherHeading}</h2>
        <p class="role-links">
          {otherPrefix}{' '}
          <a href={firstLink.href}>{firstLink.label}</a>{' '}
          {otherAnd}{' '}
          <a href={secondLink.href}>{secondLink.label}</a>.
        </p>
      </div>
    </section>

    <section class="role-section">
      <div class="role-container role-bottom-cta">
        <h2 class="gradient-text role-bottom-cta-heading">{bottomCtaHeading}</h2>
        <p class="role-bottom-cta-text">{bottomCtaText}</p>
        <a href={contactHref} class="role-btn role-btn-primary">{contactLabel}</a>
      </div>
    </section>
  </main>
  <div class="role-lightbox" id="role-lightbox" role="dialog" aria-label={lang === 'en' ? 'Enlarged screenshot' : 'Screenshot vergroot'} aria-modal="true">
    <button class="role-lightbox-close" id="role-lightbox-close" type="button" aria-label={lang === 'en' ? 'Close' : 'Sluiten'}>&times;</button>
    <img src="" alt="" class="role-lightbox-img" id="role-lightbox-img" />
  </div>
  <Footer lang={lang} />
</BaseLayout>

<script>
  const zoomableScreens = document.querySelectorAll('.zoomable-screenshot');
  const lightbox = document.getElementById('role-lightbox');
  const lightboxImg = document.getElementById('role-lightbox-img');
  const closeBtn = document.getElementById('role-lightbox-close');

  const openLightbox = (img: HTMLImageElement) => {
    if (!lightbox || !(lightboxImg instanceof HTMLImageElement)) return;
    lightboxImg.src = img.currentSrc || img.src;
    lightboxImg.alt = img.alt || '';
    lightbox.classList.add('active');
    document.body.style.overflow = 'hidden';
  };

  const closeLightbox = () => {
    if (!lightbox || !(lightboxImg instanceof HTMLImageElement)) return;
    lightbox.classList.remove('active');
    lightboxImg.src = '';
    document.body.style.overflow = '';
  };

  zoomableScreens.forEach((img) => {
    if (!(img instanceof HTMLImageElement)) return;
    img.tabIndex = 0;
    img.setAttribute('role', 'button');
    img.setAttribute('aria-label', `Open screenshot: ${img.alt || 'image'}`);

    img.addEventListener('click', () => openLightbox(img));
    img.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openLightbox(img);
      }
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);

  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && lightbox?.classList.contains('active')) closeLightbox();
  });
</script>

<style>
  .role-page {
    padding: 4.5rem 1rem 4rem;
    background: linear-gradient(180deg, #FFFFFF 0%, #ECF8F6 45%, #FFFFFF 100%);
  }

  .role-container {
    max-width: 72rem;
    margin: 0 auto;
  }

  .role-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .role-grid { grid-template-columns: 1fr 1fr; }
  }

  .role-kicker {
    font-weight: 700;
    color: #00908B;
    margin-bottom: 0.4rem;
  }

  .role-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 0.75rem;
    line-height: 1.1;
  }

  .role-intro {
    font-size: 1.15rem;
    color: #475569;
    max-width: 40rem;
  }

  .role-actions {
    margin-top: 1.25rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .role-btn {
    display: inline-flex;
    padding: 0.7rem 1rem;
    border-radius: 0.7rem;
    font-weight: 700;
    text-decoration: none;
  }

  .role-btn-primary {
    background: var(--rondo-btn-primary);
    color: #fff;
  }

  .role-btn-outline {
    border: 2px solid var(--rondo-btn-outline);
    color: var(--rondo-btn-outline);
  }

  .role-shot {
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 18px 45px rgba(0, 27, 96, 0.2);
  }

  .role-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  :global(.zoomable-screenshot) {
    cursor: zoom-in;
  }

  :global(.zoomable-screenshot:focus-visible) {
    outline: 3px solid #00908B;
    outline-offset: 2px;
  }

  .role-shot-multi {
    padding: 0.5rem;
    background: #F2F7FA;
  }

  .role-shot-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .role-shot-grid img {
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 5;
    object-fit: cover;
    border-radius: 0.75rem;
    box-shadow: 0 8px 24px rgba(0, 27, 96, 0.12);
  }

  .role-shot-pass-wide .role-shot-grid {
    grid-template-columns: 1.18fr 0.82fr;
  }

  .role-shot-pass-wide .role-shot-grid img:first-child {
    aspect-ratio: 1206 / 1637;
  }

  .role-shot-pass-wide .role-shot-grid img:last-child {
    aspect-ratio: 1206 / 2052;
    object-fit: contain;
    background: #0E1A33;
  }

  .role-section {
    margin-top: 3rem;
  }

  .role-heading {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .role-list {
    color: #334155;
    line-height: 1.8;
    list-style: disc;
    list-style-position: outside;
    padding-left: 1.2rem;
    margin: 0;
  }

  .role-list li + li {
    margin-top: 0.2rem;
  }

  .role-cards {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .role-cards { grid-template-columns: repeat(3, 1fr); }
  }

  .role-card {
    background: #F2F7FA;
    border: 1px solid #D8E3EE;
    border-radius: 1rem;
    padding: 1.2rem;
  }

  .role-card h3 {
    margin-bottom: 0.4rem;
    font-size: 1.2rem;
  }

  .role-card p {
    color: #475569;
  }

  .role-links {
    color: #475569;
  }

  .role-links a {
    color: #00908B;
    text-underline-offset: 2px;
  }

  .role-bottom-cta {
    padding: 1.3rem;
    border-radius: 1rem;
    border: 1px solid #D8E3EE;
    background: #FFFFFF;
    box-shadow: 0 10px 26px rgba(0, 27, 96, 0.08);
  }

  .role-bottom-cta-heading {
    margin-bottom: 0.45rem;
    font-size: clamp(1.45rem, 2.4vw, 1.9rem);
  }

  .role-bottom-cta-text {
    color: #475569;
    margin: 0 0 1rem;
    max-width: 48rem;
  }

  .role-lightbox {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1100;
    background: rgba(15, 23, 42, 0.84);
    padding: 1rem;
  }

  .role-lightbox.active {
    display: flex;
  }

  .role-lightbox-img {
    max-width: min(1200px, 94vw);
    max-height: 88vh;
    border-radius: 0.85rem;
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.35);
    background: #fff;
  }

  .role-lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    font-size: 1.65rem;
    line-height: 1;
    background: rgba(255, 255, 255, 0.9);
    color: #0F172A;
  }

  .role-lightbox-close:hover {
    background: #FFFFFF;
  }

</style>
