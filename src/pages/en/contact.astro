---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import ContactForm from '../../components/sections/ContactForm.astro';
import Footer from '../../components/sections/Footer.astro';

const lang = 'en' as const;
---

<BaseLayout lang={lang} title="Contact us — Rondo" description="Reach the Rondo team with questions about member administration, sponsorship, or a demo for your club.">
  <Header lang={lang} />
  <main id="main-content" class="contact-page">
    <section class="contact-intro">
      <div class="contact-intro-inner">
        <h1 class="gradient-text contact-title">Get in touch</h1>
        <p class="contact-subtitle">
          Tell us a bit about your club and what you need. We usually reply within one business day.
        </p>
      </div>
    </section>
    <ContactForm lang={lang} showHeading={false} />
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .contact-page {
    background: var(--rondo-surface-lilac);
  }

  .contact-intro {
    padding: 4rem 1.5rem 1rem;
  }

  .contact-page :global(.contact-section) {
    padding-top: 1.25rem;
    padding-bottom: 4rem;
  }

  .contact-intro-inner {
    max-width: 56rem;
    margin: 0 auto;
  }


  .contact-title {
    font-weight: 700;
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.1;
  }

  .contact-subtitle {
    margin: 0.85rem 0 0;
    color: #475569;
    font-size: 1.08rem;
    max-width: 40rem;
  }
</style>
