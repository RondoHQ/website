---
import RolePage from '../../components/pages/RolePage.astro';
---

<RolePage
  lang="en"
  title="For board & IT — Rondo"
  description="Rondo for board and IT: integration visibility, role access and operational continuity."
  kicker="For your role"
  roleTitle="Board & IT"
  intro="Keep continuity and control with clear visibility of integrations, role-based access and operational data flows."
  demoLabel="Look at the demo"
  contactLabel="Contact us"
  contactHref="/en/contact/"
  screenshotSrc="/screenshot-commissie-overzicht.webp"
  screenshotAlt="Overview in Rondo Club"
  screenshotWidth={1920}
  screenshotHeight={1080}
  whatHeading="What this solves"
  bulletPoints={[
    'One source of truth across systems through Rondo Sync.',
    'Lower operational risk during board transitions.',
    'Every member can get their own account: they only see the parts that are relevant to them.',
    'Specialist roles grant only the access needed, for example for VOG management, sponsor management or a staff roster.',
    'Sensitive fields are protected separately: finance data for finance roles, support data for member administration and sponsor data for sponsor management.',
    'Financial access is split into read-only and manage; free-form notes are limited to administrators, member administration and finance roles.',
    'Rooms, Clothing and Club TV can be off, available to administrators only or fully enabled for each club.',
    'Authenticated integrations can use three read-only actions through WordPress REST or MCP: search accessible records, retrieve one record and request the visible field schema.',
    'These integrations reuse existing Rondo permissions: a user or connected application only sees accessible people, teams, committees and fields.',
    'Clear governance around access, processes and responsibilities.',
  ]}
  cards={[
    { title: 'Architecture with visibility', text: 'Sportlink, Laposta, FreeScout and optional Nikki and Sponsit work together through one sync layer.' },
    { title: 'Manageable integrations', text: 'You keep track of connected systems and how changes propagate.' },
    { title: 'Role-based access', text: 'Rondo enforces role access across navigation, pages and data requests, so a hidden section also remains technically protected.' },
  ]}
  otherHeading="Other paths"
  otherPrefix="Also relevant:"
  otherAnd="and"
  otherLinks={[
    { href: '/en/for-secretary/', label: 'For secretaries' },
    { href: '/en/for-member-administration/', label: 'For member administration' },
  ]}
/>
