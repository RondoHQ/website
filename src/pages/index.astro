---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Hero from '../components/sections/Hero.astro';
import ProductStory from '../components/sections/ProductStory.astro';
import FeatureGallery from '../components/sections/FeatureGallery.astro';
import Origin from '../components/sections/Origin.astro';
import IntegrationDiagram from '../components/sections/IntegrationDiagram.astro';
import GettingStarted from '../components/sections/GettingStarted.astro';
import Pricing from '../components/sections/Pricing.astro';
import BusinessCase from '../components/sections/BusinessCase.astro';
import Support from '../components/sections/Support.astro';
import FAQ from '../components/sections/FAQ.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import Footer from '../components/sections/Footer.astro';
---
<BaseLayout>
  <Header />
  <main id="main-content">
    <Hero />
    <ProductStory />
    <FeatureGallery />
    <Origin />
    <IntegrationDiagram />
    <GettingStarted />
    <Pricing />
    <BusinessCase />
    <Support />
    <FAQ />
    <ContactForm />
  </main>
  <Footer />
</BaseLayout>
