---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Rondo - Sportclub Management Platform"
  description="Modern management platform for sports clubs"
>
  <main class="container mx-auto px-4 py-16">
    <div class="max-w-4xl mx-auto text-center space-y-8">
      <h1 class="text-5xl md:text-6xl font-bold">
        Rondo
      </h1>

      <p class="text-2xl md:text-3xl text-electric-cyan font-semibold">
        Sportclub Management Platform
      </p>

      <p class="text-xl text-bright-cobalt">
        Modern beheer voor moderne sportverenigingen
      </p>

      <div class="mt-12 p-8 bg-deep-midnight rounded-lg">
        <p class="text-lg">
          Een complete oplossing voor ledenadministratie, teams en planning.
        </p>
      </div>

      <div class="mt-8 text-sm text-gray-400">
        <p>Design system verification: All theme colors active</p>
        <div class="flex gap-4 justify-center mt-4">
          <div class="w-12 h-12 bg-electric-cyan rounded"></div>
          <div class="w-12 h-12 bg-bright-cobalt rounded"></div>
          <div class="w-12 h-12 bg-deep-midnight rounded"></div>
          <div class="w-12 h-12 bg-obsidian border border-white rounded"></div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
