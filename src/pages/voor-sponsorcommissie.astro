  contactLabel="Neem contact op"
  contactHref="/contact/"
  screenshotSrc="/screenshot-sponsors-placeholder.svg"
  screenshotAlt="Sponsorbeheer in Rondo Club"
  screenshotWidth={1600}
  screenshotHeight={900}
