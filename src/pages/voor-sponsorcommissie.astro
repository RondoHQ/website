    { title: 'Sponsit-koppeling', text: 'Sponsors die je in Sponsit beheert, verschijnen automatisch in Rondo. Eén keer invoeren, overal actueel.' },
  ]}
  otherHeading="Andere routes"
  otherPrefix="Ook relevant:"
  otherAnd="en"
  otherLinks={[
    { href: '/voor-toegang/', label: 'Voor toegang & events' },
    { href: '/voor-communicatie/', label: 'Voor communicatie' },
  ]}
/>
