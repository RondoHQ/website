---
import '../styles/global.css';
import Seo from '@jdevalk/astro-seo-graph/Seo.astro';
import { getLocalizedMetadata } from '../data/siteMetadata';
import { buildPageGraph, type BreadcrumbItem } from '../data/graph';
import type { Lang } from '../i18n/utils';
import { getLangFromUrl, getAlternatePaths } from '../i18n/utils';
import { t } from '../i18n/translations';
import type { WebPageType } from './pageTypes';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  pageType?: WebPageType;
  faq?: Array<{ question: string; answer: string }>;
  breadcrumbs?: BreadcrumbItem[];
  noindex?: boolean;
}

const detectedLang = getLangFromUrl(Astro.url);
const lang = Astro.props.lang || detectedLang;
const meta = getLocalizedMetadata(lang);
const {
  title = meta.title,
  description = meta.description,
  pageType = 'WebPage',
  faq,
  breadcrumbs,
  noindex = false,
} = Astro.props;

const paths = getAlternatePaths(Astro.url.pathname);
const canonical = `https://rondo.club${Astro.url.pathname}`;

const graph = buildPageGraph({
  lang,
  url: canonical,
  name: title,
  description,
  pageType,
  faq,
  breadcrumbs,
});
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#9BC2D3">
  <link rel="preconnect" href="https://plausible.io">
  <Seo
    title={title}
    description={description}
    canonical={canonical}
    ogType="website"
    ogImage={meta.ogImage}
    ogImageWidth={1200}
    ogImageHeight={630}
    siteName={meta.siteName}
    locale={meta.locale}
    twitter={{ card: 'summary_large_image' }}
    graph={graph}
    noindex={noindex}
    alternates={noindex ? undefined : {
      defaultLocale: 'nl',
      entries: [
        { hreflang: 'nl', href: `https://rondo.club${paths.nl}` },
        { hreflang: 'en', href: `https://rondo.club${paths.en}` },
      ],
    }}
    extraLinks={[
      { rel: 'preload', as: 'font', href: '/fonts/figtree-latin-700-normal.woff2', type: 'font/woff2', crossorigin: 'anonymous' },
      { rel: 'icon', href: '/favicon.ico', sizes: '32x32' },
      { rel: 'icon', href: '/favicon-192.png', type: 'image/png', sizes: '192x192' },
      { rel: 'apple-touch-icon', href: '/apple-touch-icon.png' },
      { rel: 'manifest', href: '/site.webmanifest' },
      { rel: 'sitemap', href: '/sitemap-index.xml' },
      { rel: 'alternate', type: 'application/schemamap+xml', href: '/schemamap.xml', title: 'Schema map' },
    ]}
  />
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
  <script defer data-domain="rondo.club" src="https://plausible.io/js/script.js" is:inline></script>
  <script is:inline>window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
</head>
<body class="min-h-screen antialiased">
  <a href="#main-content" class="skip-link">{t('skip', lang)}</a>
  <slot />
</body>
</html>

<style>
.skip-link {
  position: absolute;
  top: -40px;
  left: 0;
  background: var(--rondo-btn-primary);
  color: white;
  padding: 8px 16px;
  text-decoration: none;
  font-weight: 700;
  z-index: 100;
  transition: top 0.2s;
}
.skip-link:focus {
  top: 0;
}
</style>
